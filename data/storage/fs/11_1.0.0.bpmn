<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definition_11" targetNamespace="http://bpmn.io/schema/bpmn" exporter="SHIFT" exporterVersion="1.0.0-beta">
  <bpmn:process id="P11" name="Hypertension Management Pathway">
    <bpmn:subProcess id="block_node_1">
      <bpmn:incoming>div_gat_3_to_block_node_1</bpmn:incoming>
      <bpmn:outgoing>block_node_1_to_conv_gat_4</bpmn:outgoing>
      <bpmn:subProcess id="block_timer_start_event_1_cycle_scope" name="Scheduled execution" triggeredByEvent="true">
        <bpmn:task id="A3" name="If blood pressure is between the defined low and high thresholds, the practitioner is alerted urgently">
          <bpmn:incoming>div_gat_1_to_A3</bpmn:incoming>
          <bpmn:outgoing>A3_to_conv_gat_2</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="A1" name="The patient completes a general health questionnaire twice a day">
          <bpmn:incoming>block_timer_start_event_1_to_A1</bpmn:incoming>
          <bpmn:outgoing>A1_to_A2</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="A2" name="The patient measures blood pressure">
          <bpmn:incoming>A1_to_A2</bpmn:incoming>
          <bpmn:outgoing>A2_to_div_gat_1</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="A4" name="if it exceeds the high threshold, the emergency team is alerted with stat priority">
          <bpmn:incoming>div_gat_1_to_A4</bpmn:incoming>
          <bpmn:outgoing>A4_to_conv_gat_2</bpmn:outgoing>
        </bpmn:task>
        <bpmn:startEvent id="block_timer_start_event_1" name="Twice a day" isInterrupting="false">
          <bpmn:outgoing>block_timer_start_event_1_to_A1</bpmn:outgoing>
          <bpmn:timerEventDefinition id="block_timer_start_event_1_definition">
            <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT12H</bpmn:timeCycle>
          </bpmn:timerEventDefinition>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="A1_to_A2" sourceRef="A1" targetRef="A2"/>
        <bpmn:sequenceFlow id="A2_to_div_gat_1" sourceRef="A2" targetRef="div_gat_1"/>
        <bpmn:sequenceFlow id="div_gat_1_to_A3" name="If blood pressure is between the defined low and high thresholds" sourceRef="div_gat_1" targetRef="A3">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">%systolic &gt; %systolic_low_threshold and %systolic &lt; %systolic_high_threshold and %diastolic &gt; %diastolic_low_threshold and %diastolic &lt; %diastolic_high_threshold</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="div_gat_1_to_A4" name="if blood pressure exceeds the high threshold" sourceRef="div_gat_1" targetRef="A4">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">%systolic &gt;= %systolic_high_threshold and %diastolic &gt;= %diastolic_high_threshold</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="A3_to_conv_gat_2" sourceRef="A3" targetRef="conv_gat_2"/>
        <bpmn:sequenceFlow id="A4_to_conv_gat_2" sourceRef="A4" targetRef="conv_gat_2"/>
        <bpmn:sequenceFlow id="block_timer_start_event_1_to_A1" sourceRef="block_timer_start_event_1" targetRef="A1"/>
        <bpmn:sequenceFlow id="conv_gat_2_to_block_end_event_1" sourceRef="conv_gat_2" targetRef="block_end_event_1"/>
        <bpmn:exclusiveGateway id="div_gat_1" gatewayDirection="Diverging">
          <bpmn:incoming>A2_to_div_gat_1</bpmn:incoming>
          <bpmn:outgoing>div_gat_1_to_A3</bpmn:outgoing>
          <bpmn:outgoing>div_gat_1_to_A4</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:exclusiveGateway id="conv_gat_2" gatewayDirection="Converging">
          <bpmn:incoming>A3_to_conv_gat_2</bpmn:incoming>
          <bpmn:incoming>A4_to_conv_gat_2</bpmn:incoming>
          <bpmn:outgoing>conv_gat_2_to_block_end_event_1</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="block_end_event_1">
          <bpmn:incoming>conv_gat_2_to_block_end_event_1</bpmn:incoming>
        </bpmn:endEvent>
      </bpmn:subProcess>
      <bpmn:startEvent id="ka_start_event_1">
        <bpmn:outgoing>ka_start_event_1_to_ka_timer_event_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="ka_start_event_1_to_ka_timer_event_1" sourceRef="ka_start_event_1" targetRef="ka_timer_event_1"/>
      <bpmn:sequenceFlow id="ka_timer_event_1_to_ka_end_event_1" sourceRef="ka_timer_event_1" targetRef="ka_end_event_1"/>
      <bpmn:intermediateCatchEvent id="ka_timer_event_1" name="">
        <bpmn:incoming>ka_start_event_1_to_ka_timer_event_1</bpmn:incoming>
        <bpmn:outgoing>ka_timer_event_1_to_ka_end_event_1</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ka_timer_event_1_definition"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="ka_end_event_1">
        <bpmn:incoming>ka_timer_event_1_to_ka_end_event_1</bpmn:incoming>
        <bpmn:terminateEventDefinition/>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:subProcess id="block_node_2">
      <bpmn:incoming>div_gat_3_to_block_node_2</bpmn:incoming>
      <bpmn:outgoing>block_node_2_to_conv_gat_4</bpmn:outgoing>
      <bpmn:subProcess id="block_timer_start_event_2_cycle_scope" name="Scheduled execution" triggeredByEvent="true">
        <bpmn:task id="A5" name="The patient takes ramipril 2.5 mg once daily">
          <bpmn:incoming>block_timer_start_event_2_to_A5</bpmn:incoming>
          <bpmn:outgoing>A5_to_block_end_event_2</bpmn:outgoing>
        </bpmn:task>
        <bpmn:startEvent id="block_timer_start_event_2" name="Once a day" isInterrupting="false">
          <bpmn:outgoing>block_timer_start_event_2_to_A5</bpmn:outgoing>
          <bpmn:timerEventDefinition id="block_timer_start_event_2_definition">
            <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle>
          </bpmn:timerEventDefinition>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="block_timer_start_event_2_to_A5" sourceRef="block_timer_start_event_2" targetRef="A5"/>
        <bpmn:sequenceFlow id="A5_to_block_end_event_2" sourceRef="A5" targetRef="block_end_event_2"/>
        <bpmn:endEvent id="block_end_event_2">
          <bpmn:incoming>A5_to_block_end_event_2</bpmn:incoming>
        </bpmn:endEvent>
      </bpmn:subProcess>
      <bpmn:startEvent id="ka_start_event_2">
        <bpmn:outgoing>ka_start_event_2_to_ka_timer_event_2</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="ka_start_event_2_to_ka_timer_event_2" sourceRef="ka_start_event_2" targetRef="ka_timer_event_2"/>
      <bpmn:sequenceFlow id="ka_timer_event_2_to_ka_end_event_2" sourceRef="ka_timer_event_2" targetRef="ka_end_event_2"/>
      <bpmn:intermediateCatchEvent id="ka_timer_event_2" name="">
        <bpmn:incoming>ka_start_event_2_to_ka_timer_event_2</bpmn:incoming>
        <bpmn:outgoing>ka_timer_event_2_to_ka_end_event_2</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ka_timer_event_2_definition"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="ka_end_event_2">
        <bpmn:incoming>ka_timer_event_2_to_ka_end_event_2</bpmn:incoming>
        <bpmn:terminateEventDefinition/>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:subProcess id="block_node_3">
      <bpmn:incoming>div_gat_3_to_block_node_3</bpmn:incoming>
      <bpmn:outgoing>block_node_3_to_conv_gat_4</bpmn:outgoing>
      <bpmn:subProcess id="block_timer_start_event_3_cycle_scope" name="Scheduled execution" triggeredByEvent="true">
        <bpmn:task id="A6" name="Every six months, the patient attends a cardiology specialist follow-up visit">
          <bpmn:incoming>block_timer_start_event_3_to_A6</bpmn:incoming>
          <bpmn:outgoing>A6_to_block_end_event_3</bpmn:outgoing>
        </bpmn:task>
        <bpmn:startEvent id="block_timer_start_event_3" name="Every six months" isInterrupting="false">
          <bpmn:outgoing>block_timer_start_event_3_to_A6</bpmn:outgoing>
          <bpmn:timerEventDefinition id="block_timer_start_event_3_definition">
            <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P6M</bpmn:timeCycle>
          </bpmn:timerEventDefinition>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="block_timer_start_event_3_to_A6" sourceRef="block_timer_start_event_3" targetRef="A6"/>
        <bpmn:sequenceFlow id="A6_to_block_end_event_3" sourceRef="A6" targetRef="block_end_event_3"/>
        <bpmn:endEvent id="block_end_event_3">
          <bpmn:incoming>A6_to_block_end_event_3</bpmn:incoming>
        </bpmn:endEvent>
      </bpmn:subProcess>
      <bpmn:startEvent id="ka_start_event_3">
        <bpmn:outgoing>ka_start_event_3_to_ka_timer_event_3</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="ka_start_event_3_to_ka_timer_event_3" sourceRef="ka_start_event_3" targetRef="ka_timer_event_3"/>
      <bpmn:sequenceFlow id="ka_timer_event_3_to_ka_end_event_3" sourceRef="ka_timer_event_3" targetRef="ka_end_event_3"/>
      <bpmn:intermediateCatchEvent id="ka_timer_event_3" name="">
        <bpmn:incoming>ka_start_event_3_to_ka_timer_event_3</bpmn:incoming>
        <bpmn:outgoing>ka_timer_event_3_to_ka_end_event_3</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ka_timer_event_3_definition"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="ka_end_event_3">
        <bpmn:incoming>ka_timer_event_3_to_ka_end_event_3</bpmn:incoming>
        <bpmn:terminateEventDefinition/>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:startEvent id="start_node">
      <bpmn:outgoing>start_node_to_div_gat_3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="start_node_to_div_gat_3" sourceRef="start_node" targetRef="div_gat_3"/>
    <bpmn:sequenceFlow id="conv_gat_4_to_end_node" sourceRef="conv_gat_4" targetRef="end_node"/>
    <bpmn:sequenceFlow id="div_gat_3_to_block_node_1" sourceRef="div_gat_3" targetRef="block_node_1"/>
    <bpmn:sequenceFlow id="block_node_1_to_conv_gat_4" sourceRef="block_node_1" targetRef="conv_gat_4"/>
    <bpmn:sequenceFlow id="div_gat_3_to_block_node_2" sourceRef="div_gat_3" targetRef="block_node_2"/>
    <bpmn:sequenceFlow id="block_node_2_to_conv_gat_4" sourceRef="block_node_2" targetRef="conv_gat_4"/>
    <bpmn:sequenceFlow id="div_gat_3_to_block_node_3" sourceRef="div_gat_3" targetRef="block_node_3"/>
    <bpmn:sequenceFlow id="block_node_3_to_conv_gat_4" sourceRef="block_node_3" targetRef="conv_gat_4"/>
    <bpmn:parallelGateway id="div_gat_3" gatewayDirection="Diverging">
      <bpmn:incoming>start_node_to_div_gat_3</bpmn:incoming>
      <bpmn:outgoing>div_gat_3_to_block_node_1</bpmn:outgoing>
      <bpmn:outgoing>div_gat_3_to_block_node_2</bpmn:outgoing>
      <bpmn:outgoing>div_gat_3_to_block_node_3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="conv_gat_4" gatewayDirection="Converging">
      <bpmn:incoming>block_node_1_to_conv_gat_4</bpmn:incoming>
      <bpmn:incoming>block_node_2_to_conv_gat_4</bpmn:incoming>
      <bpmn:incoming>block_node_3_to_conv_gat_4</bpmn:incoming>
      <bpmn:outgoing>conv_gat_4_to_end_node</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="end_node">
      <bpmn:incoming>conv_gat_4_to_end_node</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
