<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definition_7" targetNamespace="http://bpmn.io/schema/bpmn" exporter="SHIFT" exporterVersion="1.0.0-beta">
  <bpmn:process id="P07" name="Oncology Chemotherapy Monitoring Pathway">
    <bpmn:subProcess id="start_node_cycle_scope" name="Scheduled execution" triggeredByEvent="true">
      <bpmn:task id="A1" name="Following blood sample collection">
        <bpmn:incoming>start_node_to_A1</bpmn:incoming>
        <bpmn:outgoing>A1_to_div_gat_1</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="A2" name="if laboratory results are normal, chemotherapy is administered">
        <bpmn:incoming>div_gat_1_to_A2</bpmn:incoming>
        <bpmn:outgoing>A2_to_conv_gat_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="A3" name="vital signs are monitored">
        <bpmn:incoming>div_gat_1_to_A3</bpmn:incoming>
        <bpmn:outgoing>A3_to_conv_gat_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="A4" name="Otherwise, the practitioner is alerted">
        <bpmn:incoming>div_gat_1_to_A4</bpmn:incoming>
        <bpmn:outgoing>A4_to_A5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="A5" name="an ECG is performed">
        <bpmn:incoming>A4_to_A5</bpmn:incoming>
        <bpmn:outgoing>A5_to_conv_gat_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:startEvent id="start_node" name="1 occurrence(s) every 2016 seconds" isInterrupting="false">
        <bpmn:outgoing>start_node_to_A1</bpmn:outgoing>
        <bpmn:timerEventDefinition id="start_node_definition">
          <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT2016S</bpmn:timeCycle>
        </bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="A4_to_A5" sourceRef="A4" targetRef="A5"/>
      <bpmn:sequenceFlow id="start_node_to_A1" sourceRef="start_node" targetRef="A1"/>
      <bpmn:sequenceFlow id="A1_to_div_gat_1" sourceRef="A1" targetRef="div_gat_1"/>
      <bpmn:sequenceFlow id="div_gat_1_to_A2" name="if laboratory results are normal" sourceRef="div_gat_1" targetRef="A2">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">%specimen_result = "normal"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="div_gat_1_to_A3" name="if laboratory results are normal" sourceRef="div_gat_1" targetRef="A3">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">%specimen_result = "normal"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="div_gat_1_to_A4" name="Otherwise" sourceRef="div_gat_1" targetRef="A4"/>
      <bpmn:sequenceFlow id="A2_to_conv_gat_2" sourceRef="A2" targetRef="conv_gat_2"/>
      <bpmn:sequenceFlow id="A3_to_conv_gat_2" sourceRef="A3" targetRef="conv_gat_2"/>
      <bpmn:sequenceFlow id="A5_to_conv_gat_2" sourceRef="A5" targetRef="conv_gat_2"/>
      <bpmn:sequenceFlow id="conv_gat_2_to_end_node" sourceRef="conv_gat_2" targetRef="end_node"/>
      <bpmn:exclusiveGateway id="div_gat_1" gatewayDirection="Diverging" default="div_gat_1_to_A4">
        <bpmn:incoming>A1_to_div_gat_1</bpmn:incoming>
        <bpmn:outgoing>div_gat_1_to_A2</bpmn:outgoing>
        <bpmn:outgoing>div_gat_1_to_A3</bpmn:outgoing>
        <bpmn:outgoing>div_gat_1_to_A4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="conv_gat_2" gatewayDirection="Converging">
        <bpmn:incoming>A2_to_conv_gat_2</bpmn:incoming>
        <bpmn:incoming>A3_to_conv_gat_2</bpmn:incoming>
        <bpmn:incoming>A5_to_conv_gat_2</bpmn:incoming>
        <bpmn:outgoing>conv_gat_2_to_end_node</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="end_node">
        <bpmn:incoming>conv_gat_2_to_end_node</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:startEvent id="ka_start_event_1">
      <bpmn:outgoing>ka_start_event_1_to_ka_timer_event_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="ka_start_event_1_to_ka_timer_event_1" sourceRef="ka_start_event_1" targetRef="ka_timer_event_1"/>
    <bpmn:sequenceFlow id="ka_timer_event_1_to_ka_end_event_1" sourceRef="ka_timer_event_1" targetRef="ka_end_event_1"/>
    <bpmn:intermediateCatchEvent id="ka_timer_event_1" name="">
      <bpmn:incoming>ka_start_event_1_to_ka_timer_event_1</bpmn:incoming>
      <bpmn:outgoing>ka_timer_event_1_to_ka_end_event_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ka_timer_event_1_definition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ka_end_event_1">
      <bpmn:incoming>ka_timer_event_1_to_ka_end_event_1</bpmn:incoming>
      <bpmn:terminateEventDefinition/>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P07_diagram">
    <bpmndi:BPMNPlane id="P07_plane" bpmnElement="P07">
      <bpmndi:BPMNShape id="ka_end_event_1_shape" bpmnElement="ka_end_event_1">
        <dc:Bounds x="352.0" y="614.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ka_start_event_1_shape" bpmnElement="ka_start_event_1">
        <dc:Bounds x="60.0" y="614.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ka_timer_event_1_shape" bpmnElement="ka_timer_event_1">
        <dc:Bounds x="206.0" y="614.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_node_cycle_scope_shape" bpmnElement="start_node_cycle_scope" isExpanded="true">
        <dc:Bounds x="60.0" y="60.0" width="1705.5" height="464.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A1_shape" bpmnElement="A1">
        <dc:Bounds x="247.0" y="251.0" width="170" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A2_shape" bpmnElement="A2">
        <dc:Bounds x="1022.5" y="120.0" width="170" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A3_shape" bpmnElement="A3">
        <dc:Bounds x="1022.5" y="251.0" width="170" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A4_shape" bpmnElement="A4">
        <dc:Bounds x="797.5" y="394.0" width="170" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A5_shape" bpmnElement="A5">
        <dc:Bounds x="1247.5" y="394.0" width="170" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="conv_gat_2_shape" bpmnElement="conv_gat_2">
        <dc:Bounds x="1528.5" y="271.0" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="div_gat_1_shape" bpmnElement="div_gat_1">
        <dc:Bounds x="528.0" y="271.0" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_node_shape" bpmnElement="end_node">
        <dc:Bounds x="1689.5" y="278.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_node_shape" bpmnElement="start_node">
        <dc:Bounds x="100.0" y="278.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ka_start_event_1_to_ka_timer_event_1_edge" bpmnElement="ka_start_event_1_to_ka_timer_event_1">
        <di:waypoint x="96.49000000000001" y="632.0"/>
        <di:waypoint x="205.66" y="632.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ka_timer_event_1_to_ka_end_event_1_edge" bpmnElement="ka_timer_event_1_to_ka_end_event_1">
        <di:waypoint x="242.49" y="632.0"/>
        <di:waypoint x="351.66" y="632.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A1_to_div_gat_1_edge" bpmnElement="A1_to_div_gat_1">
        <di:waypoint x="417.0" y="296.0"/>
        <di:waypoint x="528.0" y="296.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A2_to_conv_gat_2_edge" bpmnElement="A2_to_conv_gat_2">
        <di:waypoint x="1192.5" y="165.0"/>
        <di:waypoint x="1208.5" y="165.0"/>
        <di:waypoint x="1208.5" y="255.0"/>
        <di:waypoint x="1553.5" y="255.0"/>
        <di:waypoint x="1553.5" y="271.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A3_to_conv_gat_2_edge" bpmnElement="A3_to_conv_gat_2">
        <di:waypoint x="1192.5" y="296.0"/>
        <di:waypoint x="1528.5" y="296.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A4_to_A5_edge" bpmnElement="A4_to_A5">
        <di:waypoint x="967.94" y="439.0"/>
        <di:waypoint x="1247.0" y="439.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A5_to_conv_gat_2_edge" bpmnElement="A5_to_conv_gat_2">
        <di:waypoint x="1417.5" y="439.0"/>
        <di:waypoint x="1433.5" y="439.0"/>
        <di:waypoint x="1433.5" y="337.0"/>
        <di:waypoint x="1553.5" y="337.0"/>
        <di:waypoint x="1553.5" y="321.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="conv_gat_2_to_end_node_edge" bpmnElement="conv_gat_2_to_end_node">
        <di:waypoint x="1578.5" y="296.0"/>
        <di:waypoint x="1689.5" y="296.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_1_to_A2_edge" bpmnElement="div_gat_1_to_A2">
        <di:waypoint x="553.0" y="271.0"/>
        <di:waypoint x="553.0" y="165.0"/>
        <di:waypoint x="1022.5" y="165.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="706.5" y="121.0" width="162.5" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_1_to_A3_edge" bpmnElement="div_gat_1_to_A3">
        <di:waypoint x="578.0" y="296.0"/>
        <di:waypoint x="1022.5" y="296.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="719.0" y="252.0" width="162.5" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_1_to_A4_edge" bpmnElement="div_gat_1_to_A4">
        <di:waypoint x="553.0" y="321.0"/>
        <di:waypoint x="553.0" y="439.0"/>
        <di:waypoint x="797.5" y="439.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="655.25" y="391.75" width="65" height="21"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="start_node_to_A1_edge" bpmnElement="start_node_to_A1">
        <di:waypoint x="136.25" y="296.0"/>
        <di:waypoint x="246.51" y="296.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
