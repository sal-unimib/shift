<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definition_2" targetNamespace="http://bpmn.io/schema/bpmn" exporter="SHIFT" exporterVersion="1.0.0-beta">
  <bpmn:process id="P02" name="Heart Failure Follow-up Management">
    <bpmn:task id="A1" name="The patient completes a post-stroke follow up questionnaire">
      <bpmn:incoming>start_node_to_A1</bpmn:incoming>
      <bpmn:outgoing>A1_to_div_gat_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A4" name="the patient attends a cardiology specialist follow-up visit">
      <bpmn:incoming>timer_node_1_to_A4</bpmn:incoming>
      <bpmn:outgoing>A4_to_A5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A5" name="The patient receives post-stroke lifestyle education">
      <bpmn:incoming>A4_to_A5</bpmn:incoming>
      <bpmn:outgoing>A5_to_conv_gat_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="block_node_1">
      <bpmn:incoming>div_gat_3_to_block_node_1</bpmn:incoming>
      <bpmn:outgoing>block_node_1_to_conv_gat_4</bpmn:outgoing>
      <bpmn:subProcess id="block_timer_start_event_1_cycle_scope" name="Scheduled execution" triggeredByEvent="true">
        <bpmn:task id="A3" name="the practitioner is alerted with urgent priority if abnormal values are detected">
          <bpmn:incoming>div_gat_1_to_A3</bpmn:incoming>
          <bpmn:outgoing>A3_to_conv_gat_2</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="A2" name="vital signs are monitored for ten days">
          <bpmn:incoming>block_timer_start_event_1_to_A2</bpmn:incoming>
          <bpmn:outgoing>A2_to_div_gat_1</bpmn:outgoing>
        </bpmn:task>
        <bpmn:startEvent id="block_timer_start_event_1" name="1 occurrence(s) every 6 seconds" isInterrupting="false">
          <bpmn:outgoing>block_timer_start_event_1_to_A2</bpmn:outgoing>
          <bpmn:timerEventDefinition id="block_timer_start_event_1_definition">
            <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT6S</bpmn:timeCycle>
          </bpmn:timerEventDefinition>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="A2_to_div_gat_1" sourceRef="A2" targetRef="div_gat_1"/>
        <bpmn:sequenceFlow id="div_gat_1_to_A3" name="if abnormal values are detected" sourceRef="div_gat_1" targetRef="A3">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">%vital_sign_result = "abnormal"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="A3_to_conv_gat_2" sourceRef="A3" targetRef="conv_gat_2"/>
        <bpmn:sequenceFlow id="block_timer_start_event_1_to_A2" sourceRef="block_timer_start_event_1" targetRef="A2"/>
        <bpmn:sequenceFlow id="conv_gat_2_to_block_end_event_1" sourceRef="conv_gat_2" targetRef="block_end_event_1"/>
        <bpmn:sequenceFlow id="div_gat_1_to_conv_gat_2" name="Otherwise" sourceRef="div_gat_1" targetRef="conv_gat_2"/>
        <bpmn:exclusiveGateway id="div_gat_1" gatewayDirection="Diverging" default="div_gat_1_to_conv_gat_2">
          <bpmn:incoming>A2_to_div_gat_1</bpmn:incoming>
          <bpmn:outgoing>div_gat_1_to_A3</bpmn:outgoing>
          <bpmn:outgoing>div_gat_1_to_conv_gat_2</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:exclusiveGateway id="conv_gat_2" gatewayDirection="Converging">
          <bpmn:incoming>A3_to_conv_gat_2</bpmn:incoming>
          <bpmn:incoming>div_gat_1_to_conv_gat_2</bpmn:incoming>
          <bpmn:outgoing>conv_gat_2_to_block_end_event_1</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="block_end_event_1">
          <bpmn:incoming>conv_gat_2_to_block_end_event_1</bpmn:incoming>
        </bpmn:endEvent>
      </bpmn:subProcess>
      <bpmn:startEvent id="ka_start_event_1">
        <bpmn:outgoing>ka_start_event_1_to_ka_timer_event_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="ka_start_event_1_to_ka_timer_event_1" sourceRef="ka_start_event_1" targetRef="ka_timer_event_1"/>
      <bpmn:sequenceFlow id="ka_timer_event_1_to_ka_end_event_1" sourceRef="ka_timer_event_1" targetRef="ka_end_event_1"/>
      <bpmn:intermediateCatchEvent id="ka_timer_event_1" name="for 1440 seconds">
        <bpmn:incoming>ka_start_event_1_to_ka_timer_event_1</bpmn:incoming>
        <bpmn:outgoing>ka_timer_event_1_to_ka_end_event_1</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ka_timer_event_1_definition">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1440S</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="ka_end_event_1">
        <bpmn:incoming>ka_timer_event_1_to_ka_end_event_1</bpmn:incoming>
        <bpmn:terminateEventDefinition/>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:startEvent id="start_node">
      <bpmn:outgoing>start_node_to_A1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="A4_to_A5" sourceRef="A4" targetRef="A5"/>
    <bpmn:sequenceFlow id="start_node_to_A1" sourceRef="start_node" targetRef="A1"/>
    <bpmn:sequenceFlow id="A1_to_div_gat_3" sourceRef="A1" targetRef="div_gat_3"/>
    <bpmn:sequenceFlow id="A5_to_conv_gat_4" sourceRef="A5" targetRef="conv_gat_4"/>
    <bpmn:sequenceFlow id="conv_gat_4_to_end_node" sourceRef="conv_gat_4" targetRef="end_node"/>
    <bpmn:sequenceFlow id="div_gat_3_to_block_node_1" sourceRef="div_gat_3" targetRef="block_node_1"/>
    <bpmn:sequenceFlow id="block_node_1_to_conv_gat_4" sourceRef="block_node_1" targetRef="conv_gat_4"/>
    <bpmn:sequenceFlow id="div_gat_3_to_timer_node_1" sourceRef="div_gat_3" targetRef="timer_node_1"/>
    <bpmn:sequenceFlow id="timer_node_1_to_A4" sourceRef="timer_node_1" targetRef="A4"/>
    <bpmn:parallelGateway id="div_gat_3" gatewayDirection="Diverging">
      <bpmn:incoming>A1_to_div_gat_3</bpmn:incoming>
      <bpmn:outgoing>div_gat_3_to_block_node_1</bpmn:outgoing>
      <bpmn:outgoing>div_gat_3_to_timer_node_1</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="conv_gat_4" gatewayDirection="Converging">
      <bpmn:incoming>A5_to_conv_gat_4</bpmn:incoming>
      <bpmn:incoming>block_node_1_to_conv_gat_4</bpmn:incoming>
      <bpmn:outgoing>conv_gat_4_to_end_node</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateCatchEvent id="timer_node_1" name="2026-10-19T09:00:00+02:00">
      <bpmn:incoming>div_gat_3_to_timer_node_1</bpmn:incoming>
      <bpmn:outgoing>timer_node_1_to_A4</bpmn:outgoing>
      <bpmn:timerEventDefinition id="timer_node_1_definition">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">2026-10-19T09:00:00+02:00</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="end_node">
      <bpmn:incoming>conv_gat_4_to_end_node</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
