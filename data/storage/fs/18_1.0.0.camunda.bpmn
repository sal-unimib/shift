      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_3_to_A3_edge" bpmnElement="div_gat_3_to_A3">
        <di:waypoint x="794.0" y="316.0"/>
        <di:waypoint x="794.0" y="237.0"/>
        <di:waypoint x="1024.2" y="237.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="837.6" y="193.0" width="143.0" height="36.0"/>
