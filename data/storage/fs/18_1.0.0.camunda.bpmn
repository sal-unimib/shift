<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definition_18_camunda" targetNamespace="http://bpmn.io/schema/bpmn" exporter="SHIFT" exporterVersion="1.0.0-beta">
  <bpmn:process id="P18" name="Breast Cancer Diagnostic Pathway" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:userTaskForm id="Form_18_1.0.0">{"id": "Form_18_1.0.0", "type": "default", "schemaVersion": 1, "components": [{"id": "Field_subject", "type": "textfield", "key": "subject"}, {"id": "Group_A1", "type": "group", "path": "A1", "components": [{"id": "Field_A1_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A1_1056_imaging_modality_concept", "type": "textfield", "key": "1056_imaging_modality_concept"}, {"id": "Field_A1_1056_body_site_concept", "type": "textfield", "key": "1056_body_site_concept"}]}, {"id": "Group_A2", "type": "group", "path": "A2", "components": [{"id": "Field_A2_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A2_1056_imaging_modality_concept", "type": "textfield", "key": "1056_imaging_modality_concept"}, {"id": "Field_A2_1056_body_site_concept", "type": "textfield", "key": "1056_body_site_concept"}]}, {"id": "Group_A3", "type": "group", "path": "A3", "components": [{"id": "Field_A3_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A3_1052_clinical_procedure_concept", "type": "textfield", "key": "1052_clinical_procedure_concept"}, {"id": "Field_A3_1052_body_site_concept", "type": "textfield", "key": "1052_body_site_concept"}]}, {"id": "Group_A4", "type": "group", "path": "A4", "components": [{"id": "Field_A4_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A4_1053_specimen_concept", "type": "textfield", "key": "1053_specimen_concept"}, {"id": "Field_A4_1053_body_site_concept", "type": "textfield", "key": "1053_body_site_concept"}]}, {"id": "Field_procedure_result", "type": "textfield", "key": "procedure_result"}, {"id": "Field_imaging_result", "type": "textfield", "key": "imaging_result"}]}</zeebe:userTaskForm>
      <zeebe:versionTag value="1.0.0"/>
    </bpmn:extensionElements>
    <bpmn:startEvent id="start_node">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:Form_18_1.0.0"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>start_node_to_A1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="A1" name="The patient undergoes mammography">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ad_perform_imaging"/>
      </bpmn:extensionElements>
      <bpmn:incoming>start_node_to_A1</bpmn:incoming>
      <bpmn:outgoing>A1_to_A2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="A2" name="breast ultrasound examination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ad_perform_imaging"/>
      </bpmn:extensionElements>
      <bpmn:incoming>A1_to_A2</bpmn:incoming>
      <bpmn:outgoing>A2_to_div_gat_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="A3" name="If results require further investigation, a breast examination is performed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ad_clinical_procedure"/>
      </bpmn:extensionElements>
      <bpmn:incoming>div_gat_3_to_A3</bpmn:incoming>
      <bpmn:outgoing>A3_to_div_gat_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="A4" name="a breast biopsy is carried out">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ad_collect_specimen"/>
      </bpmn:extensionElements>
      <bpmn:incoming>div_gat_1_to_A4</bpmn:incoming>
      <bpmn:outgoing>A4_to_conv_gat_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="A1_to_A2" sourceRef="A1" targetRef="A2"/>
    <bpmn:sequenceFlow id="start_node_to_A1" sourceRef="start_node" targetRef="A1"/>
    <bpmn:sequenceFlow id="A3_to_div_gat_1" sourceRef="A3" targetRef="div_gat_1"/>
    <bpmn:sequenceFlow id="div_gat_1_to_A4" name="If indicated by the specialist" sourceRef="div_gat_1" targetRef="A4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= procedure_result = "abnormal"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="A4_to_conv_gat_2" sourceRef="A4" targetRef="conv_gat_2"/>
    <bpmn:sequenceFlow id="A2_to_div_gat_3" sourceRef="A2" targetRef="div_gat_3"/>
    <bpmn:sequenceFlow id="div_gat_3_to_A3" name="If the results require further investigation" sourceRef="div_gat_3" targetRef="A3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= imaging_result = "to_investigate"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="conv_gat_2_to_conv_gat_4" sourceRef="conv_gat_2" targetRef="conv_gat_4"/>
    <bpmn:sequenceFlow id="conv_gat_4_to_end_node" sourceRef="conv_gat_4" targetRef="end_node"/>
    <bpmn:sequenceFlow id="div_gat_3_to_conv_gat_4" name="Otherwise" sourceRef="div_gat_3" targetRef="conv_gat_4"/>
    <bpmn:sequenceFlow id="div_gat_1_to_conv_gat_2" name="Otherwise" sourceRef="div_gat_1" targetRef="conv_gat_2"/>
    <bpmn:exclusiveGateway id="div_gat_1" gatewayDirection="Diverging" default="div_gat_1_to_conv_gat_2">
      <bpmn:incoming>A3_to_div_gat_1</bpmn:incoming>
      <bpmn:outgoing>div_gat_1_to_A4</bpmn:outgoing>
      <bpmn:outgoing>div_gat_1_to_conv_gat_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="conv_gat_2" gatewayDirection="Converging">
      <bpmn:incoming>A4_to_conv_gat_2</bpmn:incoming>
      <bpmn:incoming>div_gat_1_to_conv_gat_2</bpmn:incoming>
      <bpmn:outgoing>conv_gat_2_to_conv_gat_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="div_gat_3" gatewayDirection="Diverging" default="div_gat_3_to_conv_gat_4">
      <bpmn:incoming>A2_to_div_gat_3</bpmn:incoming>
      <bpmn:outgoing>div_gat_3_to_A3</bpmn:outgoing>
      <bpmn:outgoing>div_gat_3_to_conv_gat_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="conv_gat_4" gatewayDirection="Converging">
      <bpmn:incoming>conv_gat_2_to_conv_gat_4</bpmn:incoming>
      <bpmn:incoming>div_gat_3_to_conv_gat_4</bpmn:incoming>
      <bpmn:outgoing>conv_gat_4_to_end_node</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_node">
      <bpmn:incoming>conv_gat_4_to_end_node</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P18_diagram">
    <bpmndi:BPMNPlane id="P18_plane" bpmnElement="P18">
      <bpmndi:BPMNShape id="A1_shape" bpmnElement="A1">
        <dc:Bounds x="207.0" y="296.0" width="170.0" height="90.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A2_shape" bpmnElement="A2">
        <dc:Bounds x="488.0" y="296.0" width="170.0" height="90.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A3_shape" bpmnElement="A3">
        <dc:Bounds x="1024.2" y="187.5" width="170.0" height="99.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A4_shape" bpmnElement="A4">
        <dc:Bounds x="1549.2" y="60.0" width="170.0" height="90.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="conv_gat_2_shape" bpmnElement="conv_gat_2">
        <dc:Bounds x="1830.2" y="204.0" width="50.0" height="50.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="conv_gat_4_shape" bpmnElement="conv_gat_4">
        <dc:Bounds x="1991.2" y="332.0" width="50.0" height="50.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="div_gat_1_shape" bpmnElement="div_gat_1">
        <dc:Bounds x="1305.2" y="204.0" width="50.0" height="50.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="div_gat_3_shape" bpmnElement="div_gat_3">
        <dc:Bounds x="769.0" y="316.0" width="50.0" height="50.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_node_shape" bpmnElement="end_node">
        <dc:Bounds x="2152.2" y="339.0" width="36.0" height="36.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_node_shape" bpmnElement="start_node">
        <dc:Bounds x="60.0" y="323.0" width="36.0" height="36.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="A1_to_A2_edge" bpmnElement="A1_to_A2">
        <di:waypoint x="377.45" y="341.0"/>
        <di:waypoint x="487.95" y="341.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A2_to_div_gat_3_edge" bpmnElement="A2_to_div_gat_3">
        <di:waypoint x="658.0" y="341.0"/>
        <di:waypoint x="769.0" y="341.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A3_to_div_gat_1_edge" bpmnElement="A3_to_div_gat_1">
        <di:waypoint x="1194.2" y="237.0"/>
        <di:waypoint x="1210.2" y="237.0"/>
        <di:waypoint x="1210.2" y="229.0"/>
        <di:waypoint x="1305.2" y="229.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A4_to_conv_gat_2_edge" bpmnElement="A4_to_conv_gat_2">
        <di:waypoint x="1719.2" y="105.0"/>
        <di:waypoint x="1735.2" y="105.0"/>
        <di:waypoint x="1735.2" y="188.0"/>
        <di:waypoint x="1855.2" y="188.0"/>
        <di:waypoint x="1855.2" y="204.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="conv_gat_2_to_conv_gat_4_edge" bpmnElement="conv_gat_2_to_conv_gat_4">
        <di:waypoint x="1880.2" y="229.0"/>
        <di:waypoint x="1896.2" y="229.0"/>
        <di:waypoint x="1896.2" y="316.0"/>
        <di:waypoint x="2016.2" y="316.0"/>
        <di:waypoint x="2016.2" y="332.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="conv_gat_4_to_end_node_edge" bpmnElement="conv_gat_4_to_end_node">
        <di:waypoint x="2041.2" y="357.0"/>
        <di:waypoint x="2152.2" y="357.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_1_to_A4_edge" bpmnElement="div_gat_1_to_A4">
        <di:waypoint x="1330.2" y="204.0"/>
