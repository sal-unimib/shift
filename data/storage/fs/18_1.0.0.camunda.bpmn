          <dc:Bounds x="1377.95" y="61.0" width="123.5" height="36.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_1_to_conv_gat_2_edge" bpmnElement="div_gat_1_to_conv_gat_2">
        <di:waypoint x="1355.2" y="229.0"/>
