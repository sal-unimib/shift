      <bpmndi:BPMNEdge id="A4_to_conv_gat_2_edge" bpmnElement="A4_to_conv_gat_2">
        <di:waypoint x="1769.45" y="372.0"/>
        <di:waypoint x="1880.45" y="372.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="block_timer_start_event_1_to_div_gat_3_edge" bpmnElement="block_timer_start_event_1_to_div_gat_3">
        <di:waypoint x="601.95" y="297.0"/>
        <di:waypoint x="712.95" y="297.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="conv_gat_2_to_conv_gat_4_edge" bpmnElement="conv_gat_2_to_conv_gat_4">
        <di:waypoint x="1930.45" y="372.0"/>
        <di:waypoint x="1946.45" y="372.0"/>
        <di:waypoint x="1946.45" y="339.0"/>
        <di:waypoint x="2066.45" y="339.0"/>
        <di:waypoint x="2066.45" y="323.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="conv_gat_4_to_block_end_event_1_edge" bpmnElement="conv_gat_4_to_block_end_event_1">
        <di:waypoint x="2091.45" y="298.0"/>
        <di:waypoint x="2202.45" y="298.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_1_to_A4_edge" bpmnElement="div_gat_1_to_A4">
        <di:waypoint x="1373.95" y="372.0"/>
        <di:waypoint x="1599.45" y="372.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1402.2" y="313.0" width="169.0" height="51"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_1_to_conv_gat_2_edge" bpmnElement="div_gat_1_to_conv_gat_2">
