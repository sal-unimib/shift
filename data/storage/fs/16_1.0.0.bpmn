        <di:waypoint x="562.44" y="651.75"/>
        <di:waypoint x="671.61" y="651.75"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ka_timer_event_1_to_ka_end_event_1_edge" bpmnElement="ka_timer_event_1_to_ka_end_event_1">
        <di:waypoint x="708.44" y="651.75"/>
        <di:waypoint x="817.6100000000001" y="651.75"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A2_to_conv_gat_4_edge" bpmnElement="A2_to_conv_gat_4">
