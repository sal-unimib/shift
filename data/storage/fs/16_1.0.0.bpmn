      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="conv_gat_2_shape" bpmnElement="conv_gat_2">
        <dc:Bounds x="1880.45" y="347.0" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="conv_gat_4_shape" bpmnElement="conv_gat_4">
        <dc:Bounds x="2041.45" y="273.0" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="div_gat_1_shape" bpmnElement="div_gat_1">
        <dc:Bounds x="1323.95" y="347.0" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="div_gat_3_shape" bpmnElement="div_gat_3">
        <dc:Bounds x="712.95" y="272.0" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ka_end_event_1_shape" bpmnElement="ka_end_event_1">
        <dc:Bounds x="817.95" y="633.75" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ka_start_event_1_shape" bpmnElement="ka_start_event_1">
        <dc:Bounds x="525.95" y="633.75" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ka_timer_event_1_shape" bpmnElement="ka_timer_event_1">
        <dc:Bounds x="671.95" y="633.75" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_node_shape" bpmnElement="end_node">
        <dc:Bounds x="2428.5" y="366.875" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_node_shape" bpmnElement="start_node">
        <dc:Bounds x="60.0" y="366.875" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="A1_to_block_node_1_edge" bpmnElement="A1_to_block_node_1">
        <di:waypoint x="376.35" y="384.875"/>
        <di:waypoint x="485.56" y="384.875"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="block_node_1_to_end_node_edge" bpmnElement="block_node_1_to_end_node">
        <di:waypoint x="2318.98" y="384.875"/>
        <di:waypoint x="2428.2" y="384.875"/>
      </bpmndi:BPMNEdge>
