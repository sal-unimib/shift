# Copy to .env and replace the example credentials with the PostgreSQL configuration.
SHIFT_DB__URL=postgresql+asyncpg://shift:change-me@localhost:5432/shift
SHIFT_DB__ECHO=false
SHIFT_DB__POOL_SIZE=5
SHIFT_DB__MAX_OVERFLOW=10
SHIFT_DB__POOL_TIMEOUT=30

# Relative paths resolve against the SHIFT project directory.
SHIFT_FILESYSTEM__ARTIFACTS_DIR=data/storage/fs
SHIFT_FILESYSTEM__ONTOLOGY_DIR=data/ontology
SHIFT_FILESYSTEM__BPMN_SCHEMA_DIR=data/bpmn_schema
SHIFT_FILESYSTEM__LOGS_DIR=logs

# Camunda 8.9 REST API. NONE, BASIC or OAUTH.
SHIFT_CAMUNDA__REST_ADDRESS=http://localhost:8080/v2
SHIFT_CAMUNDA__AUTH_STRATEGY=NONE
SHIFT_CAMUNDA__REQUEST_TIMEOUT=30
SHIFT_CAMUNDA__VERIFY_SSL=true
# SHIFT_CAMUNDA__TENANT_ID=my-tenant

# BASIC:
# SHIFT_CAMUNDA__AUTH_STRATEGY=BASIC
# SHIFT_CAMUNDA__USERNAME=your-username
# SHIFT_CAMUNDA__PASSWORD=your-password

# OAuth client credentials:
# SHIFT_CAMUNDA__AUTH_STRATEGY=OAUTH
# SHIFT_CAMUNDA__CLIENT_ID=your-client-id
# SHIFT_CAMUNDA__CLIENT_SECRET=your-client-secret
# SHIFT_CAMUNDA__OAUTH_URL=https://identity.example.org/oauth/token
# SHIFT_CAMUNDA__TOKEN_AUDIENCE=zeebe.camunda.io

# Camunda: shared endpoint/authentication; separate service and worker credentials.
SHIFT_CAMUNDA__OAUTH_URL='http://shift:18080/auth/realms/camunda-platform/protocol/openid-connect/token'
SHIFT_CAMUNDA__CLIENT_ID='orchestration'
SHIFT_CAMUNDA__CLIENT_SECRET='replace-me'
SHIFT_CAMUNDA__TOKEN_AUDIENCE='orchestration-api'
WORKERS_CAMUNDA_CLIENT_ID='orchestration'
WORKERS_CAMUNDA_CLIENT_SECRET='replace-me'
WORKERS_CAMUNDA_TOKEN_AUDIENCE='orchestration-api'

# Observation publication performed by the acquisition worker.
WORKERS_FHIR_BASE_URL=http://localhost:8080/fhir
WORKERS_FHIR_API_KEY=
WORKERS_FHIR_TIMEOUT_SECONDS=30
