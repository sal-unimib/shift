<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definition_14" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:process id="P14" name="Asthma Long-term Control Pathway" isExecutable="false">
    <bpmn:subProcess id="start_node_cycle_scope" triggeredByEvent="true">
      <bpmn:task id="A1" name="The patient completes a general health questionnaire every day">
        <bpmn:incoming>start_node_to_A1</bpmn:incoming>
        <bpmn:outgoing>A1_to_A2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="A2" name="respiratory parameters are monitored for 30 minutes">
        <bpmn:incoming>A1_to_A2</bpmn:incoming>
        <bpmn:outgoing>A2_to_div_gat_1</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="A3" name="If abnormal respiratory parameters are detected, the practitioner is alerted urgently">
        <bpmn:incoming>div_gat_1_to_A3</bpmn:incoming>
        <bpmn:outgoing>A3_to_conv_gat_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="A4" name="Otherwise, the patient is educated on correct inhaler use">
        <bpmn:incoming>div_gat_1_to_A4</bpmn:incoming>
        <bpmn:outgoing>A4_to_conv_gat_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:startEvent id="start_node" name="Every day" isInterrupting="false">
        <bpmn:outgoing>start_node_to_A1</bpmn:outgoing>
        <bpmn:timerEventDefinition id="start_node_definition">
          <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle>
        </bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="A1_to_A2" sourceRef="A1" targetRef="A2" />
      <bpmn:sequenceFlow id="start_node_to_A1" sourceRef="start_node" targetRef="A1" />
      <bpmn:sequenceFlow id="A2_to_div_gat_1" sourceRef="A2" targetRef="div_gat_1" />
      <bpmn:sequenceFlow id="div_gat_1_to_A3" name="If abnormal respiratory parameters are detected" sourceRef="div_gat_1" targetRef="A3">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">%vital_sign_result = "abnormal"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="div_gat_1_to_A4" name="Otherwise" sourceRef="div_gat_1" targetRef="A4" />
      <bpmn:sequenceFlow id="A3_to_conv_gat_2" sourceRef="A3" targetRef="conv_gat_2" />
      <bpmn:sequenceFlow id="A4_to_conv_gat_2" sourceRef="A4" targetRef="conv_gat_2" />
      <bpmn:sequenceFlow id="conv_gat_2_to_end_node" sourceRef="conv_gat_2" targetRef="end_node" />
      <bpmn:exclusiveGateway id="div_gat_1" gatewayDirection="Diverging" default="div_gat_1_to_A4">
        <bpmn:incoming>A2_to_div_gat_1</bpmn:incoming>
        <bpmn:outgoing>div_gat_1_to_A3</bpmn:outgoing>
        <bpmn:outgoing>div_gat_1_to_A4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="conv_gat_2" gatewayDirection="Converging">
        <bpmn:incoming>A3_to_conv_gat_2</bpmn:incoming>
        <bpmn:incoming>A4_to_conv_gat_2</bpmn:incoming>
        <bpmn:outgoing>conv_gat_2_to_end_node</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="end_node">
        <bpmn:incoming>conv_gat_2_to_end_node</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:startEvent id="ka_start_event_1">
      <bpmn:outgoing>ka_start_event_1_to_ka_timer_event_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="ka_start_event_1_to_ka_timer_event_1" sourceRef="ka_start_event_1" targetRef="ka_timer_event_1" />
    <bpmn:sequenceFlow id="ka_timer_event_1_to_ka_end_event_1" sourceRef="ka_timer_event_1" targetRef="ka_end_event_1" />
    <bpmn:intermediateCatchEvent id="ka_timer_event_1" name="">
      <bpmn:incoming>ka_start_event_1_to_ka_timer_event_1</bpmn:incoming>
      <bpmn:outgoing>ka_timer_event_1_to_ka_end_event_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ka_timer_event_1_definition" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ka_end_event_1">
      <bpmn:incoming>ka_timer_event_1_to_ka_end_event_1</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P14_diagram">
    <bpmndi:BPMNPlane id="P14_plane" bpmnElement="P14">
      <bpmndi:BPMNShape id="start_node_cycle_scope_shape" bpmnElement="start_node_cycle_scope" isExpanded="true">
        <dc:Bounds x="160" y="60" width="1545" height="369" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A1_shape" bpmnElement="A1">
        <dc:Bounds x="347" y="216" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A2_shape" bpmnElement="A2">
        <dc:Bounds x="628" y="216" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A3_shape" bpmnElement="A3">
        <dc:Bounds x="1187" y="120" width="170" height="114" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A4_shape" bpmnElement="A4">
        <dc:Bounds x="1187" y="299" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_node_shape" bpmnElement="start_node">
        <dc:Bounds x="200" y="243" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="194" y="279" width="49" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="div_gat_1_shape" bpmnElement="div_gat_1" isMarkerVisible="true">
        <dc:Bounds x="909" y="236" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="conv_gat_2_shape" bpmnElement="conv_gat_2" isMarkerVisible="true">
        <dc:Bounds x="1468" y="236" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_node_shape" bpmnElement="end_node">
        <dc:Bounds x="1629" y="243" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="A1_to_A2_edge" bpmnElement="A1_to_A2">
        <di:waypoint x="517.45" y="261" />
        <di:waypoint x="627.95" y="261" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="start_node_to_A1_edge" bpmnElement="start_node_to_A1">
        <di:waypoint x="236.25" y="261" />
        <di:waypoint x="346.51" y="261" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A2_to_div_gat_1_edge" bpmnElement="A2_to_div_gat_1">
        <di:waypoint x="798" y="261" />
        <di:waypoint x="909" y="261" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_1_to_A3_edge" bpmnElement="div_gat_1_to_A3">
        <di:waypoint x="934" y="236" />
        <di:waypoint x="934" y="177" />
        <di:waypoint x="1186.7" y="177" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1000" y="133" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_1_to_A4_edge" bpmnElement="div_gat_1_to_A4">
        <di:waypoint x="934" y="286" />
        <di:waypoint x="934" y="344" />
        <di:waypoint x="1186.7" y="344" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1048" y="286" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A3_to_conv_gat_2_edge" bpmnElement="A3_to_conv_gat_2">
        <di:waypoint x="1357" y="177" />
        <di:waypoint x="1493" y="177" />
        <di:waypoint x="1493" y="236" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A4_to_conv_gat_2_edge" bpmnElement="A4_to_conv_gat_2">
        <di:waypoint x="1357" y="344" />
        <di:waypoint x="1493" y="344" />
        <di:waypoint x="1493" y="286" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="conv_gat_2_to_end_node_edge" bpmnElement="conv_gat_2_to_end_node">
        <di:waypoint x="1517.7" y="261" />
        <di:waypoint x="1628.7" y="261" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="ka_start_event_1_shape" bpmnElement="ka_start_event_1">
        <dc:Bounds x="160" y="519" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ka_timer_event_1_shape" bpmnElement="ka_timer_event_1">
        <dc:Bounds x="306" y="519" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ka_end_event_1_shape" bpmnElement="ka_end_event_1">
        <dc:Bounds x="452" y="519" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ka_start_event_1_to_ka_timer_event_1_edge" bpmnElement="ka_start_event_1_to_ka_timer_event_1">
        <di:waypoint x="196.49" y="537" />
        <di:waypoint x="305.65999999999997" y="537" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ka_timer_event_1_to_ka_end_event_1_edge" bpmnElement="ka_timer_event_1_to_ka_end_event_1">
        <di:waypoint x="342.49" y="537" />
        <di:waypoint x="451.66" y="537" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
