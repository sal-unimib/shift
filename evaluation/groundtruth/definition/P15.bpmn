<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definition_15" targetNamespace="http://bpmn.io/schema/bpmn" exporter="SHIFT" exporterVersion="1.0.0-beta">
  <bpmn:process id="P15" name="Diabetic Foot Care Pathway">
    <bpmn:task id="A1" name="The patient undergoes wound specimen collection">
      <bpmn:incoming>start_node_to_A1</bpmn:incoming>
      <bpmn:outgoing>A1_to_div_gat_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A2" name="If an ulcer is detected, the patient attends a general surgery specialist visit">
      <bpmn:incoming>div_gat_1_to_A2</bpmn:incoming>
      <bpmn:outgoing>A2_to_conv_gat_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A3" name="If signs of infection worsen, the clinical team is alerted">
      <bpmn:incoming>div_gat_1_to_A3</bpmn:incoming>
      <bpmn:outgoing>A3_to_A4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A4" name="therapeutic intervention is initiated">
      <bpmn:incoming>A3_to_A4</bpmn:incoming>
      <bpmn:outgoing>A4_to_conv_gat_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A5" name="Otherwise, the patient receives education on home wound care and medication guidelines">
      <bpmn:incoming>div_gat_1_to_A5</bpmn:incoming>
      <bpmn:outgoing>A5_to_conv_gat_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="start_node">
      <bpmn:outgoing>start_node_to_A1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="A3_to_A4" sourceRef="A3" targetRef="A4"/>
    <bpmn:sequenceFlow id="start_node_to_A1" sourceRef="start_node" targetRef="A1"/>
    <bpmn:sequenceFlow id="A1_to_div_gat_1" sourceRef="A1" targetRef="div_gat_1"/>
    <bpmn:sequenceFlow id="div_gat_1_to_A2" name="If an ulcer is detected" sourceRef="div_gat_1" targetRef="A2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">%specimen_result = "ulcer" or %specimen_result = "infection"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="div_gat_1_to_A3" name="If signs of infection worsen" sourceRef="div_gat_1" targetRef="A3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">%specialist_result = "bad"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="div_gat_1_to_A5" name="Otherwise" sourceRef="div_gat_1" targetRef="A5"/>
    <bpmn:sequenceFlow id="A2_to_conv_gat_2" sourceRef="A2" targetRef="conv_gat_2"/>
    <bpmn:sequenceFlow id="A4_to_conv_gat_2" sourceRef="A4" targetRef="conv_gat_2"/>
    <bpmn:sequenceFlow id="A5_to_conv_gat_2" sourceRef="A5" targetRef="conv_gat_2"/>
    <bpmn:sequenceFlow id="conv_gat_2_to_end_node" sourceRef="conv_gat_2" targetRef="end_node"/>
    <bpmn:exclusiveGateway id="div_gat_1" gatewayDirection="Diverging" default="div_gat_1_to_A5">
      <bpmn:incoming>A1_to_div_gat_1</bpmn:incoming>
      <bpmn:outgoing>div_gat_1_to_A2</bpmn:outgoing>
      <bpmn:outgoing>div_gat_1_to_A3</bpmn:outgoing>
      <bpmn:outgoing>div_gat_1_to_A5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="conv_gat_2" gatewayDirection="Converging">
      <bpmn:incoming>A2_to_conv_gat_2</bpmn:incoming>
      <bpmn:incoming>A4_to_conv_gat_2</bpmn:incoming>
      <bpmn:incoming>A5_to_conv_gat_2</bpmn:incoming>
      <bpmn:outgoing>conv_gat_2_to_end_node</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_node">
      <bpmn:incoming>conv_gat_2_to_end_node</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P15_diagram">
    <bpmndi:BPMNPlane id="P15_plane" bpmnElement="P15">
      <bpmndi:BPMNShape id="A1_shape" bpmnElement="A1">
        <dc:Bounds x="207.0" y="207.5" width="170" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A2_shape" bpmnElement="A2">
        <dc:Bounds x="999.7" y="60.0" width="170" height="99"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A3_shape" bpmnElement="A3">
        <dc:Bounds x="774.75" y="207.5" width="170" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A4_shape" bpmnElement="A4">
        <dc:Bounds x="1224.7" y="207.5" width="170" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A5_shape" bpmnElement="A5">
        <dc:Bounds x="999.7" y="346.0" width="170" height="99"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="conv_gat_2_shape" bpmnElement="conv_gat_2">
        <dc:Bounds x="1505.7" y="227.5" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="div_gat_1_shape" bpmnElement="div_gat_1">
        <dc:Bounds x="488.0" y="227.5" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_node_shape" bpmnElement="end_node">
        <dc:Bounds x="1666.7" y="234.5" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_node_shape" bpmnElement="start_node">
        <dc:Bounds x="60.0" y="234.5" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="A1_to_div_gat_1_edge" bpmnElement="A1_to_div_gat_1">
        <di:waypoint x="377.0" y="252.5"/>
        <di:waypoint x="488.0" y="252.5"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A2_to_conv_gat_2_edge" bpmnElement="A2_to_conv_gat_2">
        <di:waypoint x="1169.7" y="109.5"/>
        <di:waypoint x="1530.7" y="109.5"/>
        <di:waypoint x="1530.7" y="227.5"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A3_to_A4_edge" bpmnElement="A3_to_A4">
        <di:waypoint x="945.19" y="252.5"/>
        <di:waypoint x="1224.3" y="252.5"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A4_to_conv_gat_2_edge" bpmnElement="A4_to_conv_gat_2">
        <di:waypoint x="1394.7" y="252.5"/>
        <di:waypoint x="1505.7" y="252.5"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A5_to_conv_gat_2_edge" bpmnElement="A5_to_conv_gat_2">
        <di:waypoint x="1169.7" y="395.5"/>
        <di:waypoint x="1530.7" y="395.5"/>
        <di:waypoint x="1530.7" y="277.5"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="conv_gat_2_to_end_node_edge" bpmnElement="conv_gat_2_to_end_node">
        <di:waypoint x="1555.7" y="252.5"/>
        <di:waypoint x="1666.7" y="252.5"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_1_to_A2_edge" bpmnElement="div_gat_1_to_A2">
        <di:waypoint x="513.0" y="227.5"/>
        <di:waypoint x="513.0" y="109.5"/>
        <di:waypoint x="999.7" y="109.5"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="681.6" y="80.5" width="149.5" height="21"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_1_to_A3_edge" bpmnElement="div_gat_1_to_A3">
        <di:waypoint x="538.0" y="252.5"/>
        <di:waypoint x="774.75" y="252.5"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="565.375" y="223.5" width="182.0" height="21"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_1_to_A5_edge" bpmnElement="div_gat_1_to_A5">
        <di:waypoint x="513.0" y="277.5"/>
        <di:waypoint x="513.0" y="395.5"/>
        <di:waypoint x="999.7" y="395.5"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="723.85" y="366.5" width="65" height="21"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="start_node_to_A1_edge" bpmnElement="start_node_to_A1">
        <di:waypoint x="96.25" y="252.5"/>
        <di:waypoint x="206.51" y="252.5"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
