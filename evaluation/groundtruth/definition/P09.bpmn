<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definition_9" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:process id="P09" name="COPD Exacerbation Management" isExecutable="false">
    <bpmn:task id="A1" name="The patient undergoes respiratory observation">
      <bpmn:incoming>div_gat_5_to_A1</bpmn:incoming>
      <bpmn:outgoing>A1_to_conv_gat_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A2" name="The patient undergoes SpO2 monitoring">
      <bpmn:incoming>div_gat_5_to_A2</bpmn:incoming>
      <bpmn:outgoing>A2_to_conv_gat_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A3" name="If abnormal findings are detected, the practitioner is alerted as soon as possible">
      <bpmn:incoming>div_gat_1_to_A3</bpmn:incoming>
      <bpmn:outgoing>A3_to_conv_gat_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A5" name="The patient receives education on correct inhaler use and daily self-management strategies">
      <bpmn:incoming>div_gat_3_to_A5</bpmn:incoming>
      <bpmn:outgoing>A5_to_conv_gat_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="block_node_1">
      <bpmn:incoming>div_gat_3_to_block_node_1</bpmn:incoming>
      <bpmn:outgoing>block_node_1_to_conv_gat_4</bpmn:outgoing>
      <bpmn:subProcess id="block_timer_start_event_1_cycle_scope" triggeredByEvent="true">
        <bpmn:task id="A4" name="Bronchodilator medication is administered as 2–4 puffs every 6 hours">
          <bpmn:incoming>block_timer_start_event_1_to_A4</bpmn:incoming>
          <bpmn:outgoing>A4_to_block_end_event_1</bpmn:outgoing>
        </bpmn:task>
        <bpmn:startEvent id="block_timer_start_event_1" name="Every 6 hours" isInterrupting="false">
          <bpmn:outgoing>block_timer_start_event_1_to_A4</bpmn:outgoing>
          <bpmn:timerEventDefinition id="block_timer_start_event_1_definition">
            <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT6H</bpmn:timeCycle>
          </bpmn:timerEventDefinition>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="block_timer_start_event_1_to_A4" sourceRef="block_timer_start_event_1" targetRef="A4" />
        <bpmn:sequenceFlow id="A4_to_block_end_event_1" sourceRef="A4" targetRef="block_end_event_1" />
        <bpmn:endEvent id="block_end_event_1">
          <bpmn:incoming>A4_to_block_end_event_1</bpmn:incoming>
        </bpmn:endEvent>
      </bpmn:subProcess>
      <bpmn:startEvent id="ka_start_event_1">
        <bpmn:outgoing>ka_start_event_1_to_ka_timer_event_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="ka_start_event_1_to_ka_timer_event_1" sourceRef="ka_start_event_1" targetRef="ka_timer_event_1" />
      <bpmn:sequenceFlow id="ka_timer_event_1_to_ka_end_event_1" sourceRef="ka_timer_event_1" targetRef="ka_end_event_1" />
      <bpmn:intermediateCatchEvent id="ka_timer_event_1" name="">
        <bpmn:incoming>ka_start_event_1_to_ka_timer_event_1</bpmn:incoming>
        <bpmn:outgoing>ka_timer_event_1_to_ka_end_event_1</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ka_timer_event_1_definition" />
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="ka_end_event_1">
        <bpmn:incoming>ka_timer_event_1_to_ka_end_event_1</bpmn:incoming>
        <bpmn:terminateEventDefinition />
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:startEvent id="start_node">
      <bpmn:outgoing>start_node_to_div_gat_3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="A1_to_conv_gat_6" sourceRef="A1" targetRef="conv_gat_6" />
    <bpmn:sequenceFlow id="A2_to_conv_gat_6" sourceRef="A2" targetRef="conv_gat_6" />
    <bpmn:sequenceFlow id="div_gat_1_to_A3" name="If abnormal findings are detected" sourceRef="div_gat_1" targetRef="A3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">%vital_sign_result = "abnormal"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="A3_to_conv_gat_2" sourceRef="A3" targetRef="conv_gat_2" />
    <bpmn:sequenceFlow id="start_node_to_div_gat_3" sourceRef="start_node" targetRef="div_gat_3" />
    <bpmn:sequenceFlow id="div_gat_5_to_A1" sourceRef="div_gat_5" targetRef="A1" />
    <bpmn:sequenceFlow id="div_gat_5_to_A2" sourceRef="div_gat_5" targetRef="A2" />
    <bpmn:sequenceFlow id="div_gat_3_to_A5" sourceRef="div_gat_3" targetRef="A5" />
    <bpmn:sequenceFlow id="A5_to_conv_gat_4" sourceRef="A5" targetRef="conv_gat_4" />
    <bpmn:sequenceFlow id="conv_gat_2_to_conv_gat_4" sourceRef="conv_gat_2" targetRef="conv_gat_4" />
    <bpmn:sequenceFlow id="conv_gat_4_to_end_node" sourceRef="conv_gat_4" targetRef="end_node" />
    <bpmn:sequenceFlow id="synchronized_choice_1_join_to_div_gat_1" sourceRef="conv_gat_6" targetRef="div_gat_1" />
    <bpmn:sequenceFlow id="div_gat_3_to_block_node_1" sourceRef="div_gat_3" targetRef="block_node_1" />
    <bpmn:sequenceFlow id="block_node_1_to_conv_gat_4" sourceRef="block_node_1" targetRef="conv_gat_4" />
    <bpmn:sequenceFlow id="div_gat_1_to_conv_gat_2" name="Otherwise" sourceRef="div_gat_1" targetRef="conv_gat_2" />
    <bpmn:parallelGateway id="conv_gat_6" gatewayDirection="Converging">
      <bpmn:incoming>A1_to_conv_gat_6</bpmn:incoming>
      <bpmn:incoming>A2_to_conv_gat_6</bpmn:incoming>
      <bpmn:outgoing>synchronized_choice_1_join_to_div_gat_1</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="div_gat_3" gatewayDirection="Diverging">
      <bpmn:incoming>start_node_to_div_gat_3</bpmn:incoming>
      <bpmn:outgoing>div_gat_3_to_A5</bpmn:outgoing>
      <bpmn:outgoing>div_gat_3_to_block_node_1</bpmn:outgoing>
      <bpmn:outgoing>div_gat_3_to_div_gat_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="conv_gat_4" gatewayDirection="Converging">
      <bpmn:incoming>A5_to_conv_gat_4</bpmn:incoming>
      <bpmn:incoming>conv_gat_2_to_conv_gat_4</bpmn:incoming>
      <bpmn:incoming>block_node_1_to_conv_gat_4</bpmn:incoming>
      <bpmn:outgoing>conv_gat_4_to_end_node</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="div_gat_1" gatewayDirection="Diverging" default="div_gat_1_to_conv_gat_2">
      <bpmn:incoming>synchronized_choice_1_join_to_div_gat_1</bpmn:incoming>
      <bpmn:outgoing>div_gat_1_to_A3</bpmn:outgoing>
      <bpmn:outgoing>div_gat_1_to_conv_gat_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="conv_gat_2" gatewayDirection="Converging">
      <bpmn:incoming>A3_to_conv_gat_2</bpmn:incoming>
      <bpmn:incoming>div_gat_1_to_conv_gat_2</bpmn:incoming>
      <bpmn:outgoing>conv_gat_2_to_conv_gat_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_node">
      <bpmn:incoming>conv_gat_4_to_end_node</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="div_gat_3_to_div_gat_5" sourceRef="div_gat_3" targetRef="div_gat_5" />
    <bpmn:parallelGateway id="div_gat_5">
      <bpmn:incoming>div_gat_3_to_div_gat_5</bpmn:incoming>
      <bpmn:outgoing>div_gat_5_to_A2</bpmn:outgoing>
      <bpmn:outgoing>div_gat_5_to_A1</bpmn:outgoing>
    </bpmn:parallelGateway>
  </bpmn:process>
