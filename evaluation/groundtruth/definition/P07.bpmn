<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definition_7" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:process id="P07" name="Oncology Chemotherapy Monitoring Pathway" isExecutable="false">
    <bpmn:task id="A1" name="Following blood sample collection">
      <bpmn:incoming>start_node_to_A1</bpmn:incoming>
      <bpmn:outgoing>A1_to_div_gat_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A2" name="if laboratory results are normal, chemotherapy is administered">
      <bpmn:incoming>div_gat_3_to_A2</bpmn:incoming>
      <bpmn:outgoing>A2_to_conv_gat_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A3" name="vital signs are monitored">
      <bpmn:incoming>div_gat_3_to_A3</bpmn:incoming>
      <bpmn:outgoing>A3_to_conv_gat_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A4" name="Otherwise, the practitioner is alerted">
      <bpmn:incoming>div_gat_1_to_A4</bpmn:incoming>
      <bpmn:outgoing>A4_to_A5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A5" name="an ECG is performed">
      <bpmn:incoming>A4_to_A5</bpmn:incoming>
      <bpmn:outgoing>A5_to_conv_gat_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="start_node">
      <bpmn:outgoing>start_node_to_A1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="A4_to_A5" sourceRef="A4" targetRef="A5" />
    <bpmn:sequenceFlow id="start_node_to_A1" sourceRef="start_node" targetRef="A1" />
    <bpmn:sequenceFlow id="A1_to_div_gat_1" sourceRef="A1" targetRef="div_gat_1" />
    <bpmn:sequenceFlow id="div_gat_3_to_A2" sourceRef="div_gat_3" targetRef="A2" />
    <bpmn:sequenceFlow id="div_gat_3_to_A3" sourceRef="div_gat_3" targetRef="A3" />
    <bpmn:sequenceFlow id="div_gat_1_to_A4" name="Otherwise" sourceRef="div_gat_1" targetRef="A4" />
    <bpmn:sequenceFlow id="conv_gat_4_to_conv_gat_2" sourceRef="conv_gat_4" targetRef="conv_gat_2" />
    <bpmn:sequenceFlow id="A3_to_conv_gat_4" sourceRef="A3" targetRef="conv_gat_4" />
    <bpmn:sequenceFlow id="A5_to_conv_gat_2" sourceRef="A5" targetRef="conv_gat_2" />
    <bpmn:sequenceFlow id="conv_gat_2_to_end_node" sourceRef="conv_gat_2" targetRef="end_node" />
    <bpmn:exclusiveGateway id="div_gat_1" gatewayDirection="Diverging" default="div_gat_1_to_A4">
      <bpmn:incoming>A1_to_div_gat_1</bpmn:incoming>
      <bpmn:outgoing>div_gat_1_to_A4</bpmn:outgoing>
      <bpmn:outgoing>div_gat_1_to_div_gat_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="conv_gat_2" gatewayDirection="Converging">
      <bpmn:incoming>conv_gat_4_to_conv_gat_2</bpmn:incoming>
      <bpmn:incoming>A5_to_conv_gat_2</bpmn:incoming>
      <bpmn:outgoing>conv_gat_2_to_end_node</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_node">
      <bpmn:incoming>conv_gat_2_to_end_node</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="div_gat_1_to_div_gat_3" name="if laboratory results are normal" sourceRef="div_gat_1" targetRef="div_gat_3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">%specimen_result = "normal"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:parallelGateway id="div_gat_3">
      <bpmn:incoming>div_gat_1_to_div_gat_3</bpmn:incoming>
      <bpmn:outgoing>div_gat_3_to_A2</bpmn:outgoing>
      <bpmn:outgoing>div_gat_3_to_A3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="A2_to_conv_gat_4" sourceRef="A2" targetRef="conv_gat_4" />
    <bpmn:parallelGateway id="conv_gat_4">
      <bpmn:incoming>A2_to_conv_gat_4</bpmn:incoming>
      <bpmn:incoming>A3_to_conv_gat_4</bpmn:incoming>
      <bpmn:outgoing>conv_gat_4_to_conv_gat_2</bpmn:outgoing>
    </bpmn:parallelGateway>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P07_diagram">
    <bpmndi:BPMNPlane id="P07_plane" bpmnElement="P07">
      <bpmndi:BPMNShape id="A1_shape" bpmnElement="A1">
        <dc:Bounds x="307" y="191" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A2_shape" bpmnElement="A2">
        <dc:Bounds x="1083" y="60" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A3_shape" bpmnElement="A3">
        <dc:Bounds x="1083" y="191" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A4_shape" bpmnElement="A4">
        <dc:Bounds x="858" y="334" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A5_shape" bpmnElement="A5">
        <dc:Bounds x="1308" y="334" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_node_shape" bpmnElement="start_node">
        <dc:Bounds x="160" y="218" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="div_gat_1_shape" bpmnElement="div_gat_1" isMarkerVisible="true">
        <dc:Bounds x="588" y="211" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="conv_gat_2_shape" bpmnElement="conv_gat_2" isMarkerVisible="true">
        <dc:Bounds x="1589" y="211" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_node_shape" bpmnElement="end_node">
        <dc:Bounds x="1750" y="218" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_013l71r_di" bpmnElement="div_gat_3">
        <dc:Bounds x="745" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_15epzh0_di" bpmnElement="conv_gat_4">
        <dc:Bounds x="1365" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="A4_to_A5_edge" bpmnElement="A4_to_A5">
        <di:waypoint x="1027.94" y="379" />
        <di:waypoint x="1307" y="379" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="start_node_to_A1_edge" bpmnElement="start_node_to_A1">
        <di:waypoint x="196.25" y="236" />
        <di:waypoint x="306.51" y="236" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A1_to_div_gat_1_edge" bpmnElement="A1_to_div_gat_1">
        <di:waypoint x="477" y="236" />
        <di:waypoint x="588" y="236" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_1_to_A2_edge" bpmnElement="div_gat_3_to_A2">
        <di:waypoint x="770" y="135" />
        <di:waypoint x="770" y="105" />
        <di:waypoint x="1083" y="105" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="883" y="61" width="89" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_1_to_A3_edge" bpmnElement="div_gat_3_to_A3">
        <di:waypoint x="770" y="185" />
        <di:waypoint x="770" y="236" />
        <di:waypoint x="1083" y="236" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="756" y="197" width="89" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_1_to_A4_edge" bpmnElement="div_gat_1_to_A4">
        <di:waypoint x="613" y="261" />
        <di:waypoint x="613" y="379" />
        <di:waypoint x="857.5" y="379" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="723" y="332" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A2_to_conv_gat_2_edge" bpmnElement="conv_gat_4_to_conv_gat_2">
        <di:waypoint x="1415" y="160" />
        <di:waypoint x="1614" y="160" />
        <di:waypoint x="1614" y="211" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A3_to_conv_gat_2_edge" bpmnElement="A3_to_conv_gat_4">
        <di:waypoint x="1253" y="236" />
        <di:waypoint x="1390" y="236" />
        <di:waypoint x="1390" y="185" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A5_to_conv_gat_2_edge" bpmnElement="A5_to_conv_gat_2">
        <di:waypoint x="1478" y="379" />
        <di:waypoint x="1613" y="379" />
        <di:waypoint x="1614" y="261" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="conv_gat_2_to_end_node_edge" bpmnElement="conv_gat_2_to_end_node">
        <di:waypoint x="1638.5" y="236" />
        <di:waypoint x="1749.5" y="236" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0735qnz_di" bpmnElement="div_gat_1_to_div_gat_3">
        <di:waypoint x="613" y="211" />
        <di:waypoint x="613" y="160" />
        <di:waypoint x="745" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="615" y="117" width="89" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0gskl0g_di" bpmnElement="A2_to_conv_gat_4">
        <di:waypoint x="1253" y="105" />
        <di:waypoint x="1390" y="105" />
        <di:waypoint x="1390" y="135" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
