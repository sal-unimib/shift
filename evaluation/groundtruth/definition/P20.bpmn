<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definition_20" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:process id="P20" name="Chronic Wound Management Pathway" isExecutable="false">
    <bpmn:task id="A1" name="The patient completes a wound assessment survey">
      <bpmn:incoming>div_gat_1_to_A1</bpmn:incoming>
      <bpmn:outgoing>A1_to_synchronized_choice_1_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A2" name="The patient undergoes specimen collection">
      <bpmn:incoming>div_gat_1_to_A2</bpmn:incoming>
      <bpmn:outgoing>A2_to_synchronized_choice_1_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A3" name="If infection is suspected, therapeutic intervention is initiated">
      <bpmn:incoming>div_gat_4_to_A3</bpmn:incoming>
      <bpmn:outgoing>A3_to_div_gat_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A4" name="the patient follows a high-protein, micronutrient-dense diet rich in vitamin C and zinc, with optimal hydration and strict glycemic control">
      <bpmn:incoming>div_gat_2_to_A4</bpmn:incoming>
      <bpmn:outgoing>A4_to_conv_gat_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A6" name="The patient attends a follow-up visit after four weeks">
      <bpmn:incoming>timer_node_1_to_A6</bpmn:incoming>
      <bpmn:outgoing>A6_to_conv_gat_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="block_node_1">
      <bpmn:incoming>div_gat_2_to_block_node_1</bpmn:incoming>
      <bpmn:outgoing>block_node_1_to_conv_gat_3</bpmn:outgoing>
      <bpmn:subProcess id="block_timer_start_event_1_cycle_scope" triggeredByEvent="true">
        <bpmn:task id="A5" name="the patient takes amoxicillin 1 g every 8 hours for 7 days">
          <bpmn:incoming>block_timer_start_event_1_to_A5</bpmn:incoming>
          <bpmn:outgoing>A5_to_block_end_event_1</bpmn:outgoing>
        </bpmn:task>
        <bpmn:startEvent id="block_timer_start_event_1" name="Every 8 hour" isInterrupting="false">
          <bpmn:outgoing>block_timer_start_event_1_to_A5</bpmn:outgoing>
          <bpmn:timerEventDefinition id="block_timer_start_event_1_definition">
            <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT8H</bpmn:timeCycle>
          </bpmn:timerEventDefinition>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="block_timer_start_event_1_to_A5" sourceRef="block_timer_start_event_1" targetRef="A5" />
        <bpmn:sequenceFlow id="A5_to_block_end_event_1" sourceRef="A5" targetRef="block_end_event_1" />
        <bpmn:endEvent id="block_end_event_1">
          <bpmn:incoming>A5_to_block_end_event_1</bpmn:incoming>
        </bpmn:endEvent>
      </bpmn:subProcess>
      <bpmn:startEvent id="ka_start_event_1">
        <bpmn:outgoing>ka_start_event_1_to_ka_timer_event_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="ka_start_event_1_to_ka_timer_event_1" sourceRef="ka_start_event_1" targetRef="ka_timer_event_1" />
      <bpmn:sequenceFlow id="ka_timer_event_1_to_ka_end_event_1" sourceRef="ka_timer_event_1" targetRef="ka_end_event_1" />
      <bpmn:intermediateCatchEvent id="ka_timer_event_1" name="for 7 days">
        <bpmn:incoming>ka_start_event_1_to_ka_timer_event_1</bpmn:incoming>
        <bpmn:outgoing>ka_timer_event_1_to_ka_end_event_1</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ka_timer_event_1_definition">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="ka_end_event_1">
        <bpmn:incoming>ka_timer_event_1_to_ka_end_event_1</bpmn:incoming>
        <bpmn:terminateEventDefinition />
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:startEvent id="start_node">
      <bpmn:outgoing>start_node_to_div_gat_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="A1_to_synchronized_choice_1_join" sourceRef="A1" targetRef="synchronized_choice_1_join" />
    <bpmn:sequenceFlow id="A2_to_synchronized_choice_1_join" sourceRef="A2" targetRef="synchronized_choice_1_join" />
    <bpmn:sequenceFlow id="start_node_to_div_gat_1" sourceRef="start_node" targetRef="div_gat_1" />
    <bpmn:sequenceFlow id="div_gat_1_to_A1" sourceRef="div_gat_1" targetRef="A1" />
    <bpmn:sequenceFlow id="div_gat_1_to_A2" sourceRef="div_gat_1" targetRef="A2" />
    <bpmn:sequenceFlow id="A3_to_div_gat_2" sourceRef="A3" targetRef="div_gat_2" />
    <bpmn:sequenceFlow id="div_gat_2_to_A4" sourceRef="div_gat_2" targetRef="A4" />
    <bpmn:sequenceFlow id="A4_to_conv_gat_3" sourceRef="A4" targetRef="conv_gat_3" />
    <bpmn:sequenceFlow id="A6_to_conv_gat_3" sourceRef="A6" targetRef="conv_gat_3" />
    <bpmn:sequenceFlow id="div_gat_4_to_A3" name="If infection is suspected" sourceRef="div_gat_4" targetRef="A3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">%specimen_result = "abnormal"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="conv_gat_3_to_conv_gat_5" sourceRef="conv_gat_3" targetRef="conv_gat_5" />
    <bpmn:sequenceFlow id="conv_gat_5_to_end_node" sourceRef="conv_gat_5" targetRef="end_node" />
    <bpmn:sequenceFlow id="synchronized_choice_1_join_to_div_gat_4" sourceRef="synchronized_choice_1_join" targetRef="div_gat_4" />
    <bpmn:sequenceFlow id="div_gat_2_to_block_node_1" sourceRef="div_gat_2" targetRef="block_node_1" />
    <bpmn:sequenceFlow id="block_node_1_to_conv_gat_3" sourceRef="block_node_1" targetRef="conv_gat_3" />
    <bpmn:sequenceFlow id="div_gat_2_to_timer_node_1" sourceRef="div_gat_2" targetRef="timer_node_1" />
    <bpmn:sequenceFlow id="timer_node_1_to_A6" sourceRef="timer_node_1" targetRef="A6" />
    <bpmn:sequenceFlow id="div_gat_4_to_conv_gat_5" name="Otherwise" sourceRef="div_gat_4" targetRef="conv_gat_5" />
    <bpmn:parallelGateway id="synchronized_choice_1_join" gatewayDirection="Converging">
      <bpmn:incoming>A1_to_synchronized_choice_1_join</bpmn:incoming>
      <bpmn:incoming>A2_to_synchronized_choice_1_join</bpmn:incoming>
      <bpmn:outgoing>synchronized_choice_1_join_to_div_gat_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="div_gat_1" gatewayDirection="Diverging">
      <bpmn:incoming>start_node_to_div_gat_1</bpmn:incoming>
      <bpmn:outgoing>div_gat_1_to_A1</bpmn:outgoing>
      <bpmn:outgoing>div_gat_1_to_A2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="div_gat_2" gatewayDirection="Diverging">
      <bpmn:incoming>A3_to_div_gat_2</bpmn:incoming>
      <bpmn:outgoing>div_gat_2_to_A4</bpmn:outgoing>
      <bpmn:outgoing>div_gat_2_to_block_node_1</bpmn:outgoing>
      <bpmn:outgoing>div_gat_2_to_timer_node_1</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="conv_gat_3" gatewayDirection="Converging">
      <bpmn:incoming>A4_to_conv_gat_3</bpmn:incoming>
      <bpmn:incoming>A6_to_conv_gat_3</bpmn:incoming>
      <bpmn:incoming>block_node_1_to_conv_gat_3</bpmn:incoming>
      <bpmn:outgoing>conv_gat_3_to_conv_gat_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateCatchEvent id="timer_node_1" name="4 wk">
      <bpmn:incoming>div_gat_2_to_timer_node_1</bpmn:incoming>
      <bpmn:outgoing>timer_node_1_to_A6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="timer_node_1_definition">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P4W</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="div_gat_4" gatewayDirection="Diverging" default="div_gat_4_to_conv_gat_5">
      <bpmn:incoming>synchronized_choice_1_join_to_div_gat_4</bpmn:incoming>
      <bpmn:outgoing>div_gat_4_to_A3</bpmn:outgoing>
      <bpmn:outgoing>div_gat_4_to_conv_gat_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="conv_gat_5" gatewayDirection="Converging">
      <bpmn:incoming>conv_gat_3_to_conv_gat_5</bpmn:incoming>
      <bpmn:incoming>div_gat_4_to_conv_gat_5</bpmn:incoming>
      <bpmn:outgoing>conv_gat_5_to_end_node</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_node">
      <bpmn:incoming>conv_gat_5_to_end_node</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
