<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definition_12_camunda" targetNamespace="http://bpmn.io/schema/bpmn" exporter="SHIFT" exporterVersion="1.0.0-beta">
  <bpmn:process id="P12" name="Postoperative Pain Management Pathway" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:userTaskForm id="Form_12_1.0.0_PT1">{"id": "Form_12_1.0.0_PT1", "type": "default", "schemaVersion": 1, "components": [{"id": "Field_subject", "type": "textfield", "key": "subject"}, {"id": "Group_A1", "type": "group", "path": "A1", "components": [{"id": "Field_A1_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A1_1002_questionnaire", "type": "textfield", "key": "1002_questionnaire"}]}, {"id": "Group_A2", "type": "group", "path": "A2", "components": [{"id": "Field_A2_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A2_1000_medication", "type": "textfield", "key": "1000_medication"}, {"id": "Field_A2_1000_dosage_dose_and_rate", "type": "textfield", "key": "1000_dosage_dose_and_rate"}]}, {"id": "Group_A3", "type": "group", "path": "A3", "components": [{"id": "Field_A3_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A3_1051_priority", "type": "textfield", "key": "1051_priority"}, {"id": "Field_A3_1051_payload", "type": "textfield", "key": "1051_payload"}, {"id": "Field_A3_1051_requester", "type": "textfield", "key": "1051_requester"}, {"id": "Field_A3_1051_recipient", "type": "textfield", "key": "1051_recipient"}, {"id": "Field_A3_1051_information_provider", "type": "textfield", "key": "1051_information_provider"}]}, {"id": "Field_TC_A1_cycle", "type": "textfield", "key": "TC_A1_cycle"}, {"id": "Field_TC_A1_keep_alive_bound", "type": "textfield", "key": "TC_A1_keep_alive_bound"}]}</zeebe:userTaskForm>
      <zeebe:versionTag value="1.0.0_PT1"/>
    </bpmn:extensionElements>
    <bpmn:subProcess id="start_node_cycle_scope" name="Scheduled execution" triggeredByEvent="true">
      <bpmn:startEvent id="start_node" name="Every day" isInterrupting="false">
        <bpmn:outgoing>start_node_to_A1</bpmn:outgoing>
        <bpmn:timerEventDefinition id="start_node_definition">
          <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">= TC_A1_cycle</bpmn:timeCycle>
        </bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:serviceTask id="A1" name="The patient completes a pain assessment survey">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="ad_complete_questionnaire"/>
        </bpmn:extensionElements>
        <bpmn:incoming>start_node_to_A1</bpmn:incoming>
        <bpmn:outgoing>A1_to_A2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="A2" name="Analgesic treatment is administered">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="ad_take_medication"/>
        </bpmn:extensionElements>
        <bpmn:incoming>A1_to_A2</bpmn:incoming>
        <bpmn:outgoing>A2_to_A3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="A3" name="routine alerting of the practitioner">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="ad_alert_practitioner"/>
        </bpmn:extensionElements>
        <bpmn:incoming>A2_to_A3</bpmn:incoming>
        <bpmn:outgoing>A3_to_end_node</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="A1_to_A2" sourceRef="A1" targetRef="A2"/>
      <bpmn:sequenceFlow id="A2_to_A3" sourceRef="A2" targetRef="A3"/>
      <bpmn:sequenceFlow id="start_node_to_A1" sourceRef="start_node" targetRef="A1"/>
      <bpmn:sequenceFlow id="A3_to_end_node" sourceRef="A3" targetRef="end_node"/>
      <bpmn:endEvent id="end_node">
        <bpmn:incoming>A3_to_end_node</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:startEvent id="ka_start_event_1">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:Form_12_1.0.0_PT1"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>ka_start_event_1_to_ka_timer_event_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="ka_start_event_1_to_ka_timer_event_1" sourceRef="ka_start_event_1" targetRef="ka_timer_event_1"/>
    <bpmn:sequenceFlow id="ka_timer_event_1_to_ka_end_event_1" sourceRef="ka_timer_event_1" targetRef="ka_end_event_1"/>
    <bpmn:intermediateCatchEvent id="ka_timer_event_1" name="for 1 week">
      <bpmn:incoming>ka_start_event_1_to_ka_timer_event_1</bpmn:incoming>
      <bpmn:outgoing>ka_timer_event_1_to_ka_end_event_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ka_timer_event_1_definition">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= TC_A1_keep_alive_bound</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ka_end_event_1">
      <bpmn:incoming>ka_timer_event_1_to_ka_end_event_1</bpmn:incoming>
      <bpmn:terminateEventDefinition/>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P12_diagram">
    <bpmndi:BPMNPlane id="P12_plane" bpmnElement="P12">
      <bpmndi:BPMNShape id="ka_end_event_1_shape" bpmnElement="ka_end_event_1">
        <dc:Bounds x="352.0" y="340.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ka_start_event_1_shape" bpmnElement="ka_start_event_1">
        <dc:Bounds x="60.0" y="340.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ka_timer_event_1_shape" bpmnElement="ka_timer_event_1">
        <dc:Bounds x="206.0" y="340.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_node_cycle_scope_shape" bpmnElement="start_node_cycle_scope" isExpanded="true">
        <dc:Bounds x="60.0" y="60.0" width="1102.0" height="190.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A1_shape" bpmnElement="A1">
        <dc:Bounds x="246.0" y="120.0" width="170" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A2_shape" bpmnElement="A2">
        <dc:Bounds x="526.0" y="120.0" width="170" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A3_shape" bpmnElement="A3">
        <dc:Bounds x="806.0" y="120.0" width="170" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_node_shape" bpmnElement="end_node">
        <dc:Bounds x="1086.0" y="147.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_node_shape" bpmnElement="start_node">
        <dc:Bounds x="100.0" y="147.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ka_start_event_1_to_ka_timer_event_1_edge" bpmnElement="ka_start_event_1_to_ka_timer_event_1">
        <di:waypoint x="96.49000000000001" y="358.0"/>
        <di:waypoint x="205.66" y="358.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ka_timer_event_1_to_ka_end_event_1_edge" bpmnElement="ka_timer_event_1_to_ka_end_event_1">
        <di:waypoint x="242.49" y="358.0"/>
        <di:waypoint x="351.66" y="358.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A1_to_A2_edge" bpmnElement="A1_to_A2">
        <di:waypoint x="416.15" y="165.0"/>
        <di:waypoint x="525.77" y="165.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A2_to_A3_edge" bpmnElement="A2_to_A3">
        <di:waypoint x="696.15" y="165.0"/>
        <di:waypoint x="805.77" y="165.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A3_to_end_node_edge" bpmnElement="A3_to_end_node">
        <di:waypoint x="976.41" y="165.0"/>
        <di:waypoint x="1085.51" y="165.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="start_node_to_A1_edge" bpmnElement="start_node_to_A1">
        <di:waypoint x="136.16" y="165.0"/>
        <di:waypoint x="245.66" y="165.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
