<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definition_5_camunda" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:process id="P05" name="Chronic Kidney Disease Follow-up" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:userTaskForm id="Form_5_1.0.0">{"id": "Form_5_1.0.0", "type": "default", "schemaVersion": 1, "components": [{"id": "Field_subject", "type": "textfield", "key": "subject"}, {"id": "Group_A1", "type": "group", "path": "A1", "components": [{"id": "Field_A1_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A1_1053_specimen_concept", "type": "textfield", "key": "1053_specimen_concept"}, {"id": "Field_A1_1053_body_site_concept", "type": "textfield", "key": "1053_body_site_concept"}]}, {"id": "Group_A2", "type": "group", "path": "A2", "components": [{"id": "Field_A2_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A2_1059_visit_concept", "type": "textfield", "key": "1059_visit_concept"}]}, {"id": "Group_A3", "type": "group", "path": "A3", "components": [{"id": "Field_A3_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A3_1054_oral_diet", "type": "textfield", "key": "1054_oral_diet"}, {"id": "Field_A3_1054_supplement", "type": "textfield", "key": "1054_supplement"}, {"id": "Field_A3_1054_enteral_formula", "type": "textfield", "key": "1054_enteral_formula"}]}, {"id": "Group_A4", "type": "group", "path": "A4", "components": [{"id": "Field_A4_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A4_1055_patient_instruction", "type": "textfield", "key": "1055_patient_instruction"}]}, {"id": "Field_TC_A1_cycle", "type": "textfield", "key": "TC_A1_cycle"}, {"id": "Field_TC_A1_keep_alive_bound", "type": "textfield", "key": "TC_A1_keep_alive_bound"}]}</zeebe:userTaskForm>
      <zeebe:versionTag value="1.0.0" />
    </bpmn:extensionElements>
    <bpmn:subProcess id="start_node_cycle_scope" name="Scheduled execution" triggeredByEvent="true">
      <bpmn:startEvent id="start_node" name="Every three months" isInterrupting="false">
        <bpmn:outgoing>start_node_to_A1</bpmn:outgoing>
        <bpmn:timerEventDefinition id="start_node_definition">
          <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">= TC_A1_cycle</bpmn:timeCycle>
        </bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:serviceTask id="A1" name="The patient undergoes a urine laboratory examination every three months">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="ad_collect_specimen" />
        </bpmn:extensionElements>
        <bpmn:incoming>start_node_to_A1</bpmn:incoming>
        <bpmn:outgoing>A1_to_A2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="A2" name="the patient attends a nephrology specialist visit">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="ad_specialist_visit" />
        </bpmn:extensionElements>
        <bpmn:incoming>A1_to_A2</bpmn:incoming>
        <bpmn:outgoing>A2_to_div_gat_1</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="A3" name="a low-sodium diet is recommended">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="ad_diet_indication" />
        </bpmn:extensionElements>
        <bpmn:incoming>div_gat_1_to_A3</bpmn:incoming>
        <bpmn:outgoing>A3_to_conv_gat_2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="A4" name="fluid management education is provided">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="ad_educate_patient" />
        </bpmn:extensionElements>
        <bpmn:incoming>div_gat_1_to_A4</bpmn:incoming>
        <bpmn:outgoing>A4_to_conv_gat_2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="A1_to_A2" sourceRef="A1" targetRef="A2" />
      <bpmn:sequenceFlow id="start_node_to_A1" sourceRef="start_node" targetRef="A1" />
      <bpmn:sequenceFlow id="A2_to_div_gat_1" sourceRef="A2" targetRef="div_gat_1" />
      <bpmn:sequenceFlow id="div_gat_1_to_A3" sourceRef="div_gat_1" targetRef="A3" />
      <bpmn:sequenceFlow id="div_gat_1_to_A4" sourceRef="div_gat_1" targetRef="A4" />
      <bpmn:sequenceFlow id="A3_to_conv_gat_2" sourceRef="A3" targetRef="conv_gat_2" />
      <bpmn:sequenceFlow id="A4_to_conv_gat_2" sourceRef="A4" targetRef="conv_gat_2" />
      <bpmn:sequenceFlow id="conv_gat_2_to_end_node" sourceRef="conv_gat_2" targetRef="end_node" />
      <bpmn:parallelGateway id="div_gat_1" gatewayDirection="Diverging">
        <bpmn:incoming>A2_to_div_gat_1</bpmn:incoming>
        <bpmn:outgoing>div_gat_1_to_A3</bpmn:outgoing>
        <bpmn:outgoing>div_gat_1_to_A4</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:parallelGateway id="conv_gat_2" gatewayDirection="Converging">
        <bpmn:incoming>A3_to_conv_gat_2</bpmn:incoming>
        <bpmn:incoming>A4_to_conv_gat_2</bpmn:incoming>
        <bpmn:outgoing>conv_gat_2_to_end_node</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="end_node">
        <bpmn:incoming>conv_gat_2_to_end_node</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:startEvent id="ka_start_event_1">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:Form_5_1.0.0" />
      </bpmn:extensionElements>
      <bpmn:outgoing>ka_start_event_1_to_ka_timer_event_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="ka_start_event_1_to_ka_timer_event_1" sourceRef="ka_start_event_1" targetRef="ka_timer_event_1" />
    <bpmn:sequenceFlow id="ka_timer_event_1_to_ka_end_event_1" sourceRef="ka_timer_event_1" targetRef="ka_end_event_1" />
    <bpmn:intermediateCatchEvent id="ka_timer_event_1" name="">
      <bpmn:incoming>ka_start_event_1_to_ka_timer_event_1</bpmn:incoming>
      <bpmn:outgoing>ka_timer_event_1_to_ka_end_event_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ka_timer_event_1_definition">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= TC_A1_keep_alive_bound</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ka_end_event_1">
      <bpmn:incoming>ka_timer_event_1_to_ka_end_event_1</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P05_diagram">
    <bpmndi:BPMNPlane id="P05_plane" bpmnElement="P05">
      <bpmndi:BPMNShape id="start_node_cycle_scope_shape" bpmnElement="start_node_cycle_scope" isExpanded="true">
        <dc:Bounds x="160" y="60" width="1422" height="345" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_node_shape" bpmnElement="start_node">
        <dc:Bounds x="200" y="225" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="190" y="261" width="57" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A1_shape" bpmnElement="A1">
        <dc:Bounds x="346" y="198" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A2_shape" bpmnElement="A2">
        <dc:Bounds x="626" y="198" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A3_shape" bpmnElement="A3">
        <dc:Bounds x="1066" y="120" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A4_shape" bpmnElement="A4">
        <dc:Bounds x="1066" y="275" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="div_gat_1_shape" bpmnElement="div_gat_1">
        <dc:Bounds x="906" y="218" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="conv_gat_2_shape" bpmnElement="conv_gat_2">
        <dc:Bounds x="1346" y="218" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_node_shape" bpmnElement="end_node">
        <dc:Bounds x="1506" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="A1_to_A2_edge" bpmnElement="A1_to_A2">
        <di:waypoint x="516.15" y="243" />
        <di:waypoint x="625.77" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="start_node_to_A1_edge" bpmnElement="start_node_to_A1">
        <di:waypoint x="236.16" y="243" />
        <di:waypoint x="345.65999999999997" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A2_to_div_gat_1_edge" bpmnElement="A2_to_div_gat_1">
        <di:waypoint x="796" y="243" />
        <di:waypoint x="906" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_1_to_A3_edge" bpmnElement="div_gat_1_to_A3">
        <di:waypoint x="931" y="218" />
        <di:waypoint x="931" y="165" />
        <di:waypoint x="1066" y="165" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_1_to_A4_edge" bpmnElement="div_gat_1_to_A4">
        <di:waypoint x="931" y="268" />
        <di:waypoint x="931" y="320" />
        <di:waypoint x="1066" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A3_to_conv_gat_2_edge" bpmnElement="A3_to_conv_gat_2">
        <di:waypoint x="1236" y="165" />
        <di:waypoint x="1371" y="165" />
        <di:waypoint x="1371" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A4_to_conv_gat_2_edge" bpmnElement="A4_to_conv_gat_2">
        <di:waypoint x="1236" y="320" />
        <di:waypoint x="1371" y="320" />
        <di:waypoint x="1371" y="268" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="conv_gat_2_to_end_node_edge" bpmnElement="conv_gat_2_to_end_node">
        <di:waypoint x="1396" y="243" />
        <di:waypoint x="1506" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="ka_start_event_1_shape" bpmnElement="ka_start_event_1">
        <dc:Bounds x="160" y="495" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ka_timer_event_1_shape" bpmnElement="ka_timer_event_1">
        <dc:Bounds x="306" y="495" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ka_end_event_1_shape" bpmnElement="ka_end_event_1">
        <dc:Bounds x="452" y="495" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ka_start_event_1_to_ka_timer_event_1_edge" bpmnElement="ka_start_event_1_to_ka_timer_event_1">
        <di:waypoint x="196.49" y="513" />
        <di:waypoint x="305.65999999999997" y="513" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ka_timer_event_1_to_ka_end_event_1_edge" bpmnElement="ka_timer_event_1_to_ka_end_event_1">
        <di:waypoint x="342.49" y="513" />
        <di:waypoint x="451.66" y="513" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
