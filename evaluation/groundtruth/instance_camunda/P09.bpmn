<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definition_9_camunda" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:process id="P09" name="COPD Exacerbation Management" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:userTaskForm id="Form_9_1.0.0_PT1">{"id": "Form_9_1.0.0_PT1", "type": "default", "schemaVersion": 1, "components": [{"id": "Field_subject", "type": "textfield", "key": "subject"}, {"id": "Group_A1", "type": "group", "path": "A1", "components": [{"id": "Field_A1_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A1_1058_observation_concept", "type": "textfield", "key": "1058_observation_concept"}]}, {"id": "Group_A2", "type": "group", "path": "A2", "components": [{"id": "Field_A2_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A2_1058_observation_concept", "type": "textfield", "key": "1058_observation_concept"}]}, {"id": "Group_A3", "type": "group", "path": "A3", "components": [{"id": "Field_A3_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A3_1051_priority", "type": "textfield", "key": "1051_priority"}, {"id": "Field_A3_1051_payload", "type": "textfield", "key": "1051_payload"}, {"id": "Field_A3_1051_requester", "type": "textfield", "key": "1051_requester"}, {"id": "Field_A3_1051_recipient", "type": "textfield", "key": "1051_recipient"}, {"id": "Field_A3_1051_information_provider", "type": "textfield", "key": "1051_information_provider"}]}, {"id": "Group_A4", "type": "group", "path": "A4", "components": [{"id": "Field_A4_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A4_1000_medication", "type": "textfield", "key": "1000_medication"}, {"id": "Field_A4_1000_dosage_dose_and_rate", "type": "textfield", "key": "1000_dosage_dose_and_rate"}]}, {"id": "Group_A5", "type": "group", "path": "A5", "components": [{"id": "Field_A5_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A5_1055_patient_instruction", "type": "textfield", "key": "1055_patient_instruction"}]}, {"id": "Field_TC_A1+A2_cycle", "type": "textfield", "key": "TC_A1+A2_cycle"}, {"id": "Field_TC_A4_cycle", "type": "textfield", "key": "TC_A4_cycle"}, {"id": "Field_TC_A1+A2_keep_alive_bound", "type": "textfield", "key": "TC_A1+A2_keep_alive_bound"}, {"id": "Field_TC_A4_keep_alive_bound", "type": "textfield", "key": "TC_A4_keep_alive_bound"}, {"id": "Field_spo2", "type": "textfield", "key": "spo2"}, {"id": "Field_respiration_rate", "type": "textfield", "key": "respiration_rate"}]}</zeebe:userTaskForm>
      <zeebe:versionTag value="1.0.0_PT1" />
    </bpmn:extensionElements>
    <bpmn:subProcess id="block_node_1">
      <bpmn:incoming>div_gat_3_to_block_node_1</bpmn:incoming>
      <bpmn:outgoing>block_node_1_to_conv_gat_4</bpmn:outgoing>
      <bpmn:subProcess id="block_timer_start_event_1_cycle_scope" name="Scheduled execution" triggeredByEvent="true">
        <bpmn:startEvent id="block_timer_start_event_1" name="Every hour" isInterrupting="false">
          <bpmn:outgoing>block_timer_start_event_1_to_div_cycle_1</bpmn:outgoing>
          <bpmn:timerEventDefinition id="block_timer_start_event_1_definition">
            <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">= `TC_A1+A2_cycle`</bpmn:timeCycle>
          </bpmn:timerEventDefinition>
        </bpmn:startEvent>
        <bpmn:serviceTask id="A2" name="The patient undergoes SpO2 monitoring">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="ad_request_observation" />
          </bpmn:extensionElements>
          <bpmn:incoming>div_cycle_1_to_A2</bpmn:incoming>
          <bpmn:outgoing>A2_to_conv_cycle_1</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:serviceTask id="A1" name="The patient undergoes respiratory observation">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="ad_request_observation" />
          </bpmn:extensionElements>
          <bpmn:incoming>div_cycle_1_to_A1</bpmn:incoming>
          <bpmn:outgoing>A1_to_conv_cycle_1</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="block_timer_start_event_1_to_div_cycle_1" sourceRef="block_timer_start_event_1" targetRef="div_cycle_1" />
        <bpmn:sequenceFlow id="div_cycle_1_to_A1" sourceRef="div_cycle_1" targetRef="A1" />
        <bpmn:sequenceFlow id="div_cycle_1_to_A2" sourceRef="div_cycle_1" targetRef="A2" />
        <bpmn:sequenceFlow id="A1_to_conv_cycle_1" sourceRef="A1" targetRef="conv_cycle_1" />
        <bpmn:sequenceFlow id="A2_to_conv_cycle_1" sourceRef="A2" targetRef="conv_cycle_1" />
        <bpmn:parallelGateway id="div_cycle_1" gatewayDirection="Diverging">
          <bpmn:incoming>block_timer_start_event_1_to_div_cycle_1</bpmn:incoming>
          <bpmn:outgoing>div_cycle_1_to_A1</bpmn:outgoing>
          <bpmn:outgoing>div_cycle_1_to_A2</bpmn:outgoing>
        </bpmn:parallelGateway>
        <bpmn:parallelGateway id="conv_cycle_1" gatewayDirection="Converging">
          <bpmn:incoming>A1_to_conv_cycle_1</bpmn:incoming>
          <bpmn:incoming>A2_to_conv_cycle_1</bpmn:incoming>
          <bpmn:outgoing>conv_cycle_1_to_div_gat_1</bpmn:outgoing>
        </bpmn:parallelGateway>
        <bpmn:exclusiveGateway id="div_gat_1" gatewayDirection="Diverging" default="div_gat_1_to_conv_gat_2">
          <bpmn:incoming>conv_cycle_1_to_div_gat_1</bpmn:incoming>
          <bpmn:outgoing>div_gat_1_to_A3</bpmn:outgoing>
          <bpmn:outgoing>div_gat_1_to_conv_gat_2</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="A3" name="If abnormal findings are detected, the practitioner is alerted as soon as possible">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="ad_alert_practitioner" />
          </bpmn:extensionElements>
          <bpmn:incoming>div_gat_1_to_A3</bpmn:incoming>
          <bpmn:outgoing>A3_to_conv_gat_2</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="conv_gat_2" gatewayDirection="Converging">
          <bpmn:incoming>div_gat_1_to_conv_gat_2</bpmn:incoming>
          <bpmn:incoming>A3_to_conv_gat_2</bpmn:incoming>
          <bpmn:outgoing>conv_gat_2_to_block_end_event_1</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="div_gat_1_to_A3" name="If abnormal findings are detected" sourceRef="div_gat_1" targetRef="A3">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= spo2 &gt; 0.93 and (respiration_rate &gt; 21 or respiration_rate &lt; 12)</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="div_gat_1_to_conv_gat_2" name="Otherwise" sourceRef="div_gat_1" targetRef="conv_gat_2" />
        <bpmn:sequenceFlow id="A3_to_conv_gat_2" sourceRef="A3" targetRef="conv_gat_2" />
        <bpmn:sequenceFlow id="conv_cycle_1_to_div_gat_1" sourceRef="conv_cycle_1" targetRef="div_gat_1" />
        <bpmn:endEvent id="block_end_event_1">
          <bpmn:incoming>conv_gat_2_to_block_end_event_1</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="conv_gat_2_to_block_end_event_1" sourceRef="conv_gat_2" targetRef="block_end_event_1" />
      </bpmn:subProcess>
      <bpmn:startEvent id="ka_start_event_1">
        <bpmn:outgoing>ka_start_event_1_to_ka_timer_event_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="ka_start_event_1_to_ka_timer_event_1" sourceRef="ka_start_event_1" targetRef="ka_timer_event_1" />
      <bpmn:sequenceFlow id="ka_timer_event_1_to_ka_end_event_1" sourceRef="ka_timer_event_1" targetRef="ka_end_event_1" />
      <bpmn:intermediateCatchEvent id="ka_timer_event_1" name="">
        <bpmn:incoming>ka_start_event_1_to_ka_timer_event_1</bpmn:incoming>
        <bpmn:outgoing>ka_timer_event_1_to_ka_end_event_1</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ka_timer_event_1_definition">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= `TC_A1+A2_keep_alive_bound`</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="ka_end_event_1">
        <bpmn:incoming>ka_timer_event_1_to_ka_end_event_1</bpmn:incoming>
        <bpmn:terminateEventDefinition />
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:subProcess id="block_node_2">
      <bpmn:incoming>div_gat_3_to_block_node_2</bpmn:incoming>
      <bpmn:outgoing>block_node_2_to_conv_gat_4</bpmn:outgoing>
      <bpmn:subProcess id="block_timer_start_event_2_cycle_scope" name="Scheduled execution" triggeredByEvent="true">
        <bpmn:startEvent id="block_timer_start_event_2" name="Every 6 hours" isInterrupting="false">
          <bpmn:outgoing>block_timer_start_event_2_to_A4</bpmn:outgoing>
          <bpmn:timerEventDefinition id="block_timer_start_event_2_definition">
            <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">= TC_A4_cycle</bpmn:timeCycle>
          </bpmn:timerEventDefinition>
        </bpmn:startEvent>
        <bpmn:serviceTask id="A4" name="Bronchodilator medication is administered as 2–4 puffs every 6 hours">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="ad_take_medication" />
          </bpmn:extensionElements>
          <bpmn:incoming>block_timer_start_event_2_to_A4</bpmn:incoming>
          <bpmn:outgoing>A4_to_block_end_event_2</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="block_timer_start_event_2_to_A4" sourceRef="block_timer_start_event_2" targetRef="A4" />
        <bpmn:sequenceFlow id="A4_to_block_end_event_2" sourceRef="A4" targetRef="block_end_event_2" />
        <bpmn:endEvent id="block_end_event_2">
          <bpmn:incoming>A4_to_block_end_event_2</bpmn:incoming>
        </bpmn:endEvent>
      </bpmn:subProcess>
      <bpmn:startEvent id="ka_start_event_2">
        <bpmn:outgoing>ka_start_event_2_to_ka_timer_event_2</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="ka_start_event_2_to_ka_timer_event_2" sourceRef="ka_start_event_2" targetRef="ka_timer_event_2" />
      <bpmn:sequenceFlow id="ka_timer_event_2_to_ka_end_event_2" sourceRef="ka_timer_event_2" targetRef="ka_end_event_2" />
      <bpmn:intermediateCatchEvent id="ka_timer_event_2" name="">
        <bpmn:incoming>ka_start_event_2_to_ka_timer_event_2</bpmn:incoming>
        <bpmn:outgoing>ka_timer_event_2_to_ka_end_event_2</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ka_timer_event_2_definition">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= TC_A4_keep_alive_bound</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="ka_end_event_2">
        <bpmn:incoming>ka_timer_event_2_to_ka_end_event_2</bpmn:incoming>
        <bpmn:terminateEventDefinition />
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:startEvent id="start_node">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:Form_9_1.0.0_PT1" />
      </bpmn:extensionElements>
      <bpmn:outgoing>start_node_to_div_gat_3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="A5" name="The patient receives education on correct inhaler use and daily self-management strategies">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ad_educate_patient" />
      </bpmn:extensionElements>
      <bpmn:incoming>div_gat_3_to_A5</bpmn:incoming>
      <bpmn:outgoing>A5_to_conv_gat_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="start_node_to_div_gat_3" sourceRef="start_node" targetRef="div_gat_3" />
    <bpmn:sequenceFlow id="div_gat_3_to_A5" sourceRef="div_gat_3" targetRef="A5" />
    <bpmn:sequenceFlow id="A5_to_conv_gat_4" sourceRef="A5" targetRef="conv_gat_4" />
    <bpmn:sequenceFlow id="conv_gat_4_to_end_node" sourceRef="conv_gat_4" targetRef="end_node" />
    <bpmn:sequenceFlow id="div_gat_3_to_block_node_1" sourceRef="div_gat_3" targetRef="block_node_1" />
    <bpmn:sequenceFlow id="block_node_1_to_conv_gat_4" sourceRef="block_node_1" targetRef="conv_gat_4" />
    <bpmn:sequenceFlow id="div_gat_3_to_block_node_2" sourceRef="div_gat_3" targetRef="block_node_2" />
    <bpmn:sequenceFlow id="block_node_2_to_conv_gat_4" sourceRef="block_node_2" targetRef="conv_gat_4" />
    <bpmn:parallelGateway id="div_gat_3" gatewayDirection="Diverging">
      <bpmn:incoming>start_node_to_div_gat_3</bpmn:incoming>
      <bpmn:outgoing>div_gat_3_to_A5</bpmn:outgoing>
      <bpmn:outgoing>div_gat_3_to_block_node_1</bpmn:outgoing>
      <bpmn:outgoing>div_gat_3_to_block_node_2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="conv_gat_4" gatewayDirection="Converging">
      <bpmn:incoming>A5_to_conv_gat_4</bpmn:incoming>
      <bpmn:incoming>block_node_2_to_conv_gat_4</bpmn:incoming>
      <bpmn:incoming>block_node_1_to_conv_gat_4</bpmn:incoming>
      <bpmn:outgoing>conv_gat_4_to_end_node</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="end_node">
      <bpmn:incoming>conv_gat_4_to_end_node</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
