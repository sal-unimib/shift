<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definition_3_camunda" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:process id="P03" name="Diabetes Monitoring and Treatment Adjustment" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:userTaskForm id="Form_3_1.0.0">{"id": "Form_3_1.0.0", "type": "default", "schemaVersion": 1, "components": [{"id": "Field_subject", "type": "textfield", "key": "subject"}, {"id": "Group_A1", "type": "group", "path": "A1", "components": [{"id": "Field_A1_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A1_1058_observation_concept", "type": "textfield", "key": "1058_observation_concept"}]}, {"id": "Group_A2", "type": "group", "path": "A2", "components": [{"id": "Field_A2_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A2_1051_priority", "type": "textfield", "key": "1051_priority"}, {"id": "Field_A2_1051_payload", "type": "textfield", "key": "1051_payload"}, {"id": "Field_A2_1051_requester", "type": "textfield", "key": "1051_requester"}, {"id": "Field_A2_1051_recipient", "type": "textfield", "key": "1051_recipient"}, {"id": "Field_A2_1051_information_provider", "type": "textfield", "key": "1051_information_provider"}]}, {"id": "Group_A3", "type": "group", "path": "A3", "components": [{"id": "Field_A3_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A3_1001_exercise_concept", "type": "textfield", "key": "1001_exercise_concept"}]}, {"id": "Field_TC_A1_cycle", "type": "textfield", "key": "TC_A1_cycle"}, {"id": "Field_TC_A3_execution_duration", "type": "textfield", "key": "TC_A3_execution_duration"}, {"id": "Field_TC_A1_keep_alive_bound", "type": "textfield", "key": "TC_A1_keep_alive_bound"}, {"id": "Field_glucose_level", "type": "textfield", "key": "glucose_level"}]}</zeebe:userTaskForm>
      <zeebe:versionTag value="1.0.0" />
    </bpmn:extensionElements>
    <bpmn:subProcess id="start_node_cycle_scope" name="Scheduled execution" triggeredByEvent="true">
      <bpmn:startEvent id="start_node" name="Every morning" isInterrupting="false">
        <bpmn:outgoing>start_node_to_A1</bpmn:outgoing>
        <bpmn:timerEventDefinition id="start_node_definition">
          <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">= TC_A1_cycle</bpmn:timeCycle>
        </bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:serviceTask id="A1" name="The patient monitors blood glucose every morning">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="ad_request_observation" />
        </bpmn:extensionElements>
        <bpmn:incoming>start_node_to_A1</bpmn:incoming>
        <bpmn:outgoing>A1_to_div_gat_1</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="A2" name="If the blood glucose level exceeds the prescribed threshold, the practitioner is notified as soon as possible">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="ad_alert_practitioner" />
        </bpmn:extensionElements>
        <bpmn:incoming>div_gat_1_to_A2</bpmn:incoming>
        <bpmn:outgoing>A2_to_conv_gat_2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="A3" name="Otherwise, the patient performs a 30-minute walking session.">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="ad_perform_exercise" />
        </bpmn:extensionElements>
        <bpmn:incoming>div_gat_1_to_A3</bpmn:incoming>
        <bpmn:outgoing>A3_to_conv_gat_2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="start_node_to_A1" sourceRef="start_node" targetRef="A1" />
      <bpmn:sequenceFlow id="A1_to_div_gat_1" sourceRef="A1" targetRef="div_gat_1" />
      <bpmn:sequenceFlow id="div_gat_1_to_A2" name="If the blood glucose level exceeds the prescribed threshold" sourceRef="div_gat_1" targetRef="A2">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= glucose_level &gt;= 200</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="div_gat_1_to_A3" name="Otherwise" sourceRef="div_gat_1" targetRef="A3" />
      <bpmn:sequenceFlow id="A2_to_conv_gat_2" sourceRef="A2" targetRef="conv_gat_2" />
      <bpmn:sequenceFlow id="A3_to_conv_gat_2" sourceRef="A3" targetRef="conv_gat_2" />
      <bpmn:sequenceFlow id="conv_gat_2_to_end_node" sourceRef="conv_gat_2" targetRef="end_node" />
      <bpmn:exclusiveGateway id="div_gat_1" gatewayDirection="Diverging" default="div_gat_1_to_A3">
        <bpmn:incoming>A1_to_div_gat_1</bpmn:incoming>
        <bpmn:outgoing>div_gat_1_to_A2</bpmn:outgoing>
        <bpmn:outgoing>div_gat_1_to_A3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="conv_gat_2" gatewayDirection="Converging">
        <bpmn:incoming>A2_to_conv_gat_2</bpmn:incoming>
        <bpmn:incoming>A3_to_conv_gat_2</bpmn:incoming>
        <bpmn:outgoing>conv_gat_2_to_end_node</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="end_node">
        <bpmn:incoming>conv_gat_2_to_end_node</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:startEvent id="ka_start_event_1">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:Form_3_1.0.0" />
      </bpmn:extensionElements>
      <bpmn:outgoing>ka_start_event_1_to_ka_timer_event_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="ka_start_event_1_to_ka_timer_event_1" sourceRef="ka_start_event_1" targetRef="ka_timer_event_1" />
    <bpmn:sequenceFlow id="ka_timer_event_1_to_ka_end_event_1" sourceRef="ka_timer_event_1" targetRef="ka_end_event_1" />
    <bpmn:intermediateCatchEvent id="ka_timer_event_1" name="">
      <bpmn:incoming>ka_start_event_1_to_ka_timer_event_1</bpmn:incoming>
      <bpmn:outgoing>ka_timer_event_1_to_ka_end_event_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ka_timer_event_1_definition">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= TC_A1_keep_alive_bound</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ka_end_event_1">
      <bpmn:incoming>ka_timer_event_1_to_ka_end_event_1</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P03_diagram">
    <bpmndi:BPMNPlane id="P03_plane" bpmnElement="P03">
      <bpmndi:BPMNShape id="start_node_cycle_scope_shape" bpmnElement="start_node_cycle_scope" isExpanded="true">
        <dc:Bounds x="160" y="60" width="1304" height="364" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_node_shape" bpmnElement="start_node">
        <dc:Bounds x="200" y="241" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="183" y="277" width="71" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A1_shape" bpmnElement="A1">
        <dc:Bounds x="347" y="214" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A2_shape" bpmnElement="A2">
        <dc:Bounds x="906" y="130" width="210" height="99" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A3_shape" bpmnElement="A3">
        <dc:Bounds x="926" y="294" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="div_gat_1_shape" bpmnElement="div_gat_1" isMarkerVisible="true">
        <dc:Bounds x="628" y="234" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="conv_gat_2_shape" bpmnElement="conv_gat_2" isMarkerVisible="true">
        <dc:Bounds x="1227" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_node_shape" bpmnElement="end_node">
        <dc:Bounds x="1388" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="start_node_to_A1_edge" bpmnElement="start_node_to_A1">
        <di:waypoint x="236.25" y="259" />
        <di:waypoint x="346.51" y="259" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A1_to_div_gat_1_edge" bpmnElement="A1_to_div_gat_1">
        <di:waypoint x="517" y="259" />
        <di:waypoint x="628" y="259" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_1_to_A2_edge" bpmnElement="div_gat_1_to_A2">
        <di:waypoint x="653" y="234" />
        <di:waypoint x="653" y="179" />
        <di:waypoint x="905.75" y="179" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="697" y="120" width="166" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="div_gat_1_to_A3_edge" bpmnElement="div_gat_1_to_A3">
        <di:waypoint x="653" y="284" />
        <di:waypoint x="653" y="339" />
        <di:waypoint x="925.75" y="339" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="767" y="284" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A2_to_conv_gat_2_edge" bpmnElement="A2_to_conv_gat_2">
        <di:waypoint x="1116" y="179" />
        <di:waypoint x="1252" y="179" />
        <di:waypoint x="1252" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A3_to_conv_gat_2_edge" bpmnElement="A3_to_conv_gat_2">
        <di:waypoint x="1096" y="339" />
        <di:waypoint x="1252" y="339" />
        <di:waypoint x="1252" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="conv_gat_2_to_end_node_edge" bpmnElement="conv_gat_2_to_end_node">
        <di:waypoint x="1276.7" y="260" />
        <di:waypoint x="1387.7" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="ka_start_event_1_shape" bpmnElement="ka_start_event_1">
        <dc:Bounds x="160" y="514" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ka_timer_event_1_shape" bpmnElement="ka_timer_event_1">
        <dc:Bounds x="306" y="514" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ka_end_event_1_shape" bpmnElement="ka_end_event_1">
        <dc:Bounds x="452" y="514" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ka_start_event_1_to_ka_timer_event_1_edge" bpmnElement="ka_start_event_1_to_ka_timer_event_1">
        <di:waypoint x="196.49" y="532" />
        <di:waypoint x="305.65999999999997" y="532" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ka_timer_event_1_to_ka_end_event_1_edge" bpmnElement="ka_timer_event_1_to_ka_end_event_1">
        <di:waypoint x="342.49" y="532" />
        <di:waypoint x="451.66" y="532" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
