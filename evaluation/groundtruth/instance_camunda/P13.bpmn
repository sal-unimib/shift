<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definition_13_camunda" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:process id="P13" name="Osteoarthritis Conservative Treatment Pathway" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:userTaskForm id="Form_13_1.0.0_PT1">{"id": "Form_13_1.0.0_PT1", "type": "default", "schemaVersion": 1, "components": [{"id": "Field_subject", "type": "textfield", "key": "subject"}, {"id": "Group_A1", "type": "group", "path": "A1", "components": [{"id": "Field_A1_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A1_1059_visit_concept", "type": "textfield", "key": "1059_visit_concept"}]}, {"id": "Group_A2", "type": "group", "path": "A2", "components": [{"id": "Field_A2_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A2_1000_medication", "type": "textfield", "key": "1000_medication"}, {"id": "Field_A2_1000_dosage_dose_and_rate", "type": "textfield", "key": "1000_dosage_dose_and_rate"}]}, {"id": "Group_A3", "type": "group", "path": "A3", "components": [{"id": "Field_A3_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A3_1001_exercise_concept", "type": "textfield", "key": "1001_exercise_concept"}]}, {"id": "Field_TC_A1_cycle", "type": "textfield", "key": "TC_A1_cycle"}, {"id": "Field_TC_A1_keep_alive_bound", "type": "textfield", "key": "TC_A1_keep_alive_bound"}, {"id": "Field_TC_A2_cycle", "type": "textfield", "key": "TC_A2_cycle"}, {"id": "Field_TC_A2_keep_alive_bound", "type": "textfield", "key": "TC_A2_keep_alive_bound"}, {"id": "Field_TC_A3_cycle", "type": "textfield", "key": "TC_A3_cycle"}, {"id": "Field_TC_A3_keep_alive_bound", "type": "textfield", "key": "TC_A3_keep_alive_bound"}]}</zeebe:userTaskForm>
      <zeebe:versionTag value="1.0.0_PT1" />
    </bpmn:extensionElements>
    <bpmn:subProcess id="start_node_cycle_scope" name="Scheduled execution" triggeredByEvent="true">
      <bpmn:subProcess id="block_node_1">
        <bpmn:incoming>div_gat_1_to_block_node_1</bpmn:incoming>
        <bpmn:outgoing>block_node_1_to_conv_gat_2</bpmn:outgoing>
        <bpmn:subProcess id="block_timer_start_event_1_cycle_scope" name="Scheduled execution" triggeredByEvent="true">
          <bpmn:startEvent id="block_timer_start_event_1" name="Every day" isInterrupting="false">
            <bpmn:outgoing>block_timer_start_event_1_to_A2</bpmn:outgoing>
            <bpmn:timerEventDefinition id="block_timer_start_event_1_definition">
              <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">= TC_A2_cycle</bpmn:timeCycle>
            </bpmn:timerEventDefinition>
          </bpmn:startEvent>
          <bpmn:serviceTask id="A2" name="The patient receives medication administration">
            <bpmn:extensionElements>
              <zeebe:taskDefinition type="ad_take_medication" />
            </bpmn:extensionElements>
            <bpmn:incoming>block_timer_start_event_1_to_A2</bpmn:incoming>
            <bpmn:outgoing>A2_to_block_end_event_1</bpmn:outgoing>
          </bpmn:serviceTask>
          <bpmn:sequenceFlow id="block_timer_start_event_1_to_A2" sourceRef="block_timer_start_event_1" targetRef="A2" />
          <bpmn:sequenceFlow id="A2_to_block_end_event_1" sourceRef="A2" targetRef="block_end_event_1" />
          <bpmn:endEvent id="block_end_event_1">
            <bpmn:incoming>A2_to_block_end_event_1</bpmn:incoming>
          </bpmn:endEvent>
        </bpmn:subProcess>
        <bpmn:startEvent id="ka_start_event_2">
          <bpmn:outgoing>ka_start_event_2_to_ka_timer_event_2</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="ka_start_event_2_to_ka_timer_event_2" sourceRef="ka_start_event_2" targetRef="ka_timer_event_2" />
        <bpmn:sequenceFlow id="ka_timer_event_2_to_ka_end_event_2" sourceRef="ka_timer_event_2" targetRef="ka_end_event_2" />
        <bpmn:intermediateCatchEvent id="ka_timer_event_2" name="for 1 month">
          <bpmn:incoming>ka_start_event_2_to_ka_timer_event_2</bpmn:incoming>
          <bpmn:outgoing>ka_timer_event_2_to_ka_end_event_2</bpmn:outgoing>
          <bpmn:timerEventDefinition id="ka_timer_event_2_definition">
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= TC_A2_keep_alive_bound</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:intermediateCatchEvent>
        <bpmn:endEvent id="ka_end_event_2">
          <bpmn:incoming>ka_timer_event_2_to_ka_end_event_2</bpmn:incoming>
          <bpmn:terminateEventDefinition />
        </bpmn:endEvent>
      </bpmn:subProcess>
      <bpmn:subProcess id="block_node_2">
        <bpmn:incoming>div_gat_1_to_block_node_2</bpmn:incoming>
        <bpmn:outgoing>block_node_2_to_conv_gat_2</bpmn:outgoing>
        <bpmn:subProcess id="block_timer_start_event_2_cycle_scope" name="Scheduled execution" triggeredByEvent="true">
          <bpmn:startEvent id="block_timer_start_event_2" name="Twice a week" isInterrupting="false">
            <bpmn:outgoing>block_timer_start_event_2_to_A3</bpmn:outgoing>
            <bpmn:timerEventDefinition id="block_timer_start_event_2_definition">
              <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">= TC_A3_cycle</bpmn:timeCycle>
            </bpmn:timerEventDefinition>
          </bpmn:startEvent>
          <bpmn:serviceTask id="A3" name="The patient performs prescribed exercises">
            <bpmn:extensionElements>
              <zeebe:taskDefinition type="ad_perform_exercise" />
            </bpmn:extensionElements>
            <bpmn:incoming>block_timer_start_event_2_to_A3</bpmn:incoming>
            <bpmn:outgoing>A3_to_block_end_event_2</bpmn:outgoing>
          </bpmn:serviceTask>
          <bpmn:sequenceFlow id="block_timer_start_event_2_to_A3" sourceRef="block_timer_start_event_2" targetRef="A3" />
          <bpmn:sequenceFlow id="A3_to_block_end_event_2" sourceRef="A3" targetRef="block_end_event_2" />
          <bpmn:endEvent id="block_end_event_2">
            <bpmn:incoming>A3_to_block_end_event_2</bpmn:incoming>
          </bpmn:endEvent>
        </bpmn:subProcess>
        <bpmn:startEvent id="ka_start_event_3">
          <bpmn:outgoing>ka_start_event_3_to_ka_timer_event_3</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="ka_start_event_3_to_ka_timer_event_3" sourceRef="ka_start_event_3" targetRef="ka_timer_event_3" />
        <bpmn:sequenceFlow id="ka_timer_event_3_to_ka_end_event_3" sourceRef="ka_timer_event_3" targetRef="ka_end_event_3" />
        <bpmn:intermediateCatchEvent id="ka_timer_event_3" name="for 1 month">
          <bpmn:incoming>ka_start_event_3_to_ka_timer_event_3</bpmn:incoming>
          <bpmn:outgoing>ka_timer_event_3_to_ka_end_event_3</bpmn:outgoing>
          <bpmn:timerEventDefinition id="ka_timer_event_3_definition">
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= TC_A3_keep_alive_bound</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:intermediateCatchEvent>
        <bpmn:endEvent id="ka_end_event_3">
          <bpmn:incoming>ka_timer_event_3_to_ka_end_event_3</bpmn:incoming>
          <bpmn:terminateEventDefinition />
        </bpmn:endEvent>
      </bpmn:subProcess>
      <bpmn:startEvent id="start_node" name="Monthly" isInterrupting="false">
        <bpmn:outgoing>start_node_to_A1</bpmn:outgoing>
        <bpmn:timerEventDefinition id="start_node_definition">
          <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">= TC_A1_cycle</bpmn:timeCycle>
        </bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:serviceTask id="A1" name="The patient attends a monthly rheumatology specialist visit">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="ad_specialist_visit" />
        </bpmn:extensionElements>
        <bpmn:incoming>start_node_to_A1</bpmn:incoming>
        <bpmn:outgoing>A1_to_div_gat_1</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="start_node_to_A1" sourceRef="start_node" targetRef="A1" />
      <bpmn:sequenceFlow id="A1_to_div_gat_1" sourceRef="A1" targetRef="div_gat_1" />
      <bpmn:sequenceFlow id="conv_gat_2_to_end_node" sourceRef="conv_gat_2" targetRef="end_node" />
      <bpmn:sequenceFlow id="div_gat_1_to_block_node_1" sourceRef="div_gat_1" targetRef="block_node_1" />
      <bpmn:sequenceFlow id="block_node_1_to_conv_gat_2" sourceRef="block_node_1" targetRef="conv_gat_2" />
      <bpmn:sequenceFlow id="div_gat_1_to_block_node_2" sourceRef="div_gat_1" targetRef="block_node_2" />
      <bpmn:sequenceFlow id="block_node_2_to_conv_gat_2" sourceRef="block_node_2" targetRef="conv_gat_2" />
      <bpmn:parallelGateway id="div_gat_1" gatewayDirection="Diverging">
        <bpmn:incoming>A1_to_div_gat_1</bpmn:incoming>
        <bpmn:outgoing>div_gat_1_to_block_node_1</bpmn:outgoing>
        <bpmn:outgoing>div_gat_1_to_block_node_2</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:parallelGateway id="conv_gat_2" gatewayDirection="Converging">
        <bpmn:incoming>block_node_1_to_conv_gat_2</bpmn:incoming>
        <bpmn:incoming>block_node_2_to_conv_gat_2</bpmn:incoming>
        <bpmn:outgoing>conv_gat_2_to_end_node</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="end_node">
        <bpmn:incoming>conv_gat_2_to_end_node</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:startEvent id="ka_start_event_1">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:Form_13_1.0.0_PT1" />
      </bpmn:extensionElements>
      <bpmn:outgoing>ka_start_event_1_to_ka_timer_event_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="ka_start_event_1_to_ka_timer_event_1" sourceRef="ka_start_event_1" targetRef="ka_timer_event_1" />
    <bpmn:sequenceFlow id="ka_timer_event_1_to_ka_end_event_1" sourceRef="ka_timer_event_1" targetRef="ka_end_event_1" />
    <bpmn:intermediateCatchEvent id="ka_timer_event_1" name="for 1 year">
      <bpmn:incoming>ka_start_event_1_to_ka_timer_event_1</bpmn:incoming>
      <bpmn:outgoing>ka_timer_event_1_to_ka_end_event_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ka_timer_event_1_definition">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= TC_A1_keep_alive_bound</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ka_end_event_1">
      <bpmn:incoming>ka_timer_event_1_to_ka_end_event_1</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
  </bpmn:process>
