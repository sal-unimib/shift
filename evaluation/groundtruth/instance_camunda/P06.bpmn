<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definition_6_camunda" targetNamespace="http://bpmn.io/schema/bpmn" exporter="SHIFT" exporterVersion="1.0.0-beta">
  <bpmn:process id="P06" name="Cardiac Rehabilitation After Myocardial Infarction" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:userTaskForm id="Form_6_1.0.0_PT1">{"id": "Form_6_1.0.0_PT1", "type": "default", "schemaVersion": 1, "components": [{"id": "Field_subject", "type": "textfield", "key": "subject"}, {"id": "Group_A1", "type": "group", "path": "A1", "components": [{"id": "Field_A1_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A1_1057_therapy_concept", "type": "textfield", "key": "1057_therapy_concept"}, {"id": "Field_A1_1057_body_site_concept", "type": "textfield", "key": "1057_body_site_concept"}]}, {"id": "Group_A2", "type": "group", "path": "A2", "components": [{"id": "Field_A2_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A2_1001_exercise_concept", "type": "textfield", "key": "1001_exercise_concept"}]}, {"id": "Group_A3", "type": "group", "path": "A3", "components": [{"id": "Field_A3_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A3_1058_observation_concept", "type": "textfield", "key": "1058_observation_concept"}]}, {"id": "Group_A4", "type": "group", "path": "A4", "components": [{"id": "Field_A4_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A4_1002_questionnaire", "type": "textfield", "key": "1002_questionnaire"}]}, {"id": "Field_TC_A1_exact", "type": "textfield", "key": "TC_A1_exact"}, {"id": "Field_TC_A2+A3_cycle", "type": "textfield", "key": "TC_A2+A3_cycle"}, {"id": "Field_TC_A2_execution_duration", "type": "textfield", "key": "TC_A2_execution_duration"}, {"id": "Field_TC_A2_execution_bound", "type": "textfield", "key": "TC_A2_execution_bound"}, {"id": "Field_TC_A2+A3_keep_alive_bound", "type": "textfield", "key": "TC_A2+A3_keep_alive_bound"}]}</zeebe:userTaskForm>
      <zeebe:versionTag value="1.0.0_PT1" />
    </bpmn:extensionElements>
    <bpmn:subProcess id="block_node_1">
      <bpmn:incoming>A1_to_block_node_1</bpmn:incoming>
      <bpmn:outgoing>block_node_1_to_end_node</bpmn:outgoing>
      <bpmn:subProcess id="block_timer_start_event_1_cycle_scope" name="Scheduled execution" triggeredByEvent="true">
        <bpmn:startEvent id="block_timer_start_event_1" name="Three times per day" isInterrupting="false">
          <bpmn:outgoing>block_timer_start_event_1_to_div_gat_1</bpmn:outgoing>
          <bpmn:timerEventDefinition id="block_timer_start_event_1_definition">
            <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">= `TC_A2+A3_cycle`</bpmn:timeCycle>
          </bpmn:timerEventDefinition>
        </bpmn:startEvent>
        <bpmn:serviceTask id="A2" name="the patient performs aerobic exercises three times per day">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="ad_perform_exercise" />
          </bpmn:extensionElements>
          <bpmn:incoming>div_gat_1_to_A2</bpmn:incoming>
          <bpmn:outgoing>A2_to_conv_bound_1</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:serviceTask id="A4" name="The patient subsequently completes a general health questionnaire">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="ad_complete_questionnaire" />
          </bpmn:extensionElements>
          <bpmn:incoming>conv_gat_2_to_A4</bpmn:incoming>
          <bpmn:outgoing>A4_to_block_end_event_1</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:serviceTask id="A3" name="monitoring heart rate three times per day">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="ad_request_observation" />
          </bpmn:extensionElements>
          <bpmn:incoming>div_gat_1_to_A3</bpmn:incoming>
          <bpmn:outgoing>A3_to_conv_gat_2</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="div_gat_1_to_A2" sourceRef="div_gat_1" targetRef="A2" />
        <bpmn:sequenceFlow id="div_gat_1_to_A3" sourceRef="div_gat_1" targetRef="A3" />
        <bpmn:sequenceFlow id="A3_to_conv_gat_2" sourceRef="A3" targetRef="conv_gat_2" />
        <bpmn:sequenceFlow id="conv_gat_2_to_A4" sourceRef="conv_gat_2" targetRef="A4" />
        <bpmn:sequenceFlow id="block_timer_start_event_1_to_div_gat_1" sourceRef="block_timer_start_event_1" targetRef="div_gat_1" />
        <bpmn:sequenceFlow id="A4_to_block_end_event_1" sourceRef="A4" targetRef="block_end_event_1" />
        <bpmn:sequenceFlow id="conv_bound_1_to_conv_gat_2" sourceRef="conv_bound_1" targetRef="conv_gat_2" />
        <bpmn:sequenceFlow id="A2_to_conv_bound_1" sourceRef="A2" targetRef="conv_bound_1" />
        <bpmn:sequenceFlow id="boundary_node_1_to_conv_bound_1" sourceRef="boundary_node_1" targetRef="conv_bound_1" />
        <bpmn:parallelGateway id="conv_gat_2" gatewayDirection="Converging">
          <bpmn:incoming>A3_to_conv_gat_2</bpmn:incoming>
          <bpmn:incoming>conv_bound_1_to_conv_gat_2</bpmn:incoming>
          <bpmn:outgoing>conv_gat_2_to_A4</bpmn:outgoing>
        </bpmn:parallelGateway>
        <bpmn:parallelGateway id="div_gat_1" gatewayDirection="Diverging">
          <bpmn:incoming>block_timer_start_event_1_to_div_gat_1</bpmn:incoming>
          <bpmn:outgoing>div_gat_1_to_A2</bpmn:outgoing>
          <bpmn:outgoing>div_gat_1_to_A3</bpmn:outgoing>
        </bpmn:parallelGateway>
        <bpmn:exclusiveGateway id="conv_bound_1" gatewayDirection="Converging">
          <bpmn:incoming>A2_to_conv_bound_1</bpmn:incoming>
          <bpmn:incoming>boundary_node_1_to_conv_bound_1</bpmn:incoming>
          <bpmn:outgoing>conv_bound_1_to_conv_gat_2</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="block_end_event_1">
          <bpmn:incoming>A4_to_block_end_event_1</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:boundaryEvent id="boundary_node_1" name="30 minutes" attachedToRef="A2">
          <bpmn:outgoing>boundary_node_1_to_conv_bound_1</bpmn:outgoing>
          <bpmn:timerEventDefinition id="boundary_node_1_definition">
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= TC_A2_execution_bound</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
      </bpmn:subProcess>
      <bpmn:startEvent id="ka_start_event_1">
        <bpmn:outgoing>ka_start_event_1_to_ka_timer_event_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="ka_start_event_1_to_ka_timer_event_1" sourceRef="ka_start_event_1" targetRef="ka_timer_event_1" />
      <bpmn:sequenceFlow id="ka_timer_event_1_to_ka_end_event_1" sourceRef="ka_timer_event_1" targetRef="ka_end_event_1" />
      <bpmn:intermediateCatchEvent id="ka_timer_event_1" name="for 1 month">
        <bpmn:incoming>ka_start_event_1_to_ka_timer_event_1</bpmn:incoming>
        <bpmn:outgoing>ka_timer_event_1_to_ka_end_event_1</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ka_timer_event_1_definition">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= `TC_A2+A3_keep_alive_bound`</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="ka_end_event_1">
        <bpmn:incoming>ka_timer_event_1_to_ka_end_event_1</bpmn:incoming>
        <bpmn:terminateEventDefinition />
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:startEvent id="start_node">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:Form_6_1.0.0_PT1" />
      </bpmn:extensionElements>
      <bpmn:outgoing>start_node_to_timer_node_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="A1" name="The patient undergoes cardiac rehabilitation therapy">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ad_provide_therapy" />
      </bpmn:extensionElements>
      <bpmn:incoming>timer_node_1_to_A1</bpmn:incoming>
      <bpmn:outgoing>A1_to_block_node_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="A1_to_block_node_1" sourceRef="A1" targetRef="block_node_1" />
    <bpmn:sequenceFlow id="block_node_1_to_end_node" sourceRef="block_node_1" targetRef="end_node" />
    <bpmn:sequenceFlow id="start_node_to_timer_node_1" sourceRef="start_node" targetRef="timer_node_1" />
    <bpmn:sequenceFlow id="timer_node_1_to_A1" sourceRef="timer_node_1" targetRef="A1" />
    <bpmn:intermediateCatchEvent id="timer_node_1" name="2026-10-19T09:00:00+02:00">
      <bpmn:incoming>start_node_to_timer_node_1</bpmn:incoming>
      <bpmn:outgoing>timer_node_1_to_A1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="timer_node_1_definition">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">= TC_A1_exact</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="end_node">
      <bpmn:incoming>block_node_1_to_end_node</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
