        <dc:Bounds x="347" y="251" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A4_shape" bpmnElement="A4">
        <dc:Bounds x="898" y="394" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="div_gat_1_shape" bpmnElement="div_gat_1" isMarkerVisible="true">
        <dc:Bounds x="628" y="271" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="conv_gat_2_shape" bpmnElement="conv_gat_2" isMarkerVisible="true">
        <dc:Bounds x="1629" y="271" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_node_shape" bpmnElement="end_node">
        <dc:Bounds x="1790" y="278" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1b70w9m_di" bpmnElement="div_gat_3">
        <dc:Bounds x="755" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A3_shape" bpmnElement="A3">
        <dc:Bounds x="1025" y="215" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A2_shape" bpmnElement="A2">
        <dc:Bounds x="1025" y="95" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_0ktmc5s_di" bpmnElement="conv_gat_4">
        <dc:Bounds x="1415" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A5_shape" bpmnElement="A5">
        <dc:Bounds x="1235" y="394" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="start_node_to_A1_edge" bpmnElement="start_node_to_A1">
        <di:waypoint x="236.25" y="296" />
        <di:waypoint x="346.51" y="296" />
      </bpmndi:BPMNEdge>
