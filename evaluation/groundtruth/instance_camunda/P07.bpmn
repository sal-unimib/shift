<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definition_7_camunda" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:process id="P07" name="Oncology Chemotherapy Monitoring Pathway" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:userTaskForm id="Form_7_1.0.0_PT1">{"id": "Form_7_1.0.0_PT1", "type": "default", "schemaVersion": 1, "components": [{"id": "Field_subject", "type": "textfield", "key": "subject"}, {"id": "Group_A1", "type": "group", "path": "A1", "components": [{"id": "Field_A1_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A1_1053_specimen_concept", "type": "textfield", "key": "1053_specimen_concept"}, {"id": "Field_A1_1053_body_site_concept", "type": "textfield", "key": "1053_body_site_concept"}]}, {"id": "Group_A2", "type": "group", "path": "A2", "components": [{"id": "Field_A2_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A2_1052_clinical_procedure_concept", "type": "textfield", "key": "1052_clinical_procedure_concept"}, {"id": "Field_A2_1052_body_site_concept", "type": "textfield", "key": "1052_body_site_concept"}]}, {"id": "Group_A3", "type": "group", "path": "A3", "components": [{"id": "Field_A3_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A3_1058_observation_concept", "type": "textfield", "key": "1058_observation_concept"}]}, {"id": "Group_A4", "type": "group", "path": "A4", "components": [{"id": "Field_A4_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A4_1051_priority", "type": "textfield", "key": "1051_priority"}, {"id": "Field_A4_1051_payload", "type": "textfield", "key": "1051_payload"}, {"id": "Field_A4_1051_requester", "type": "textfield", "key": "1051_requester"}, {"id": "Field_A4_1051_recipient", "type": "textfield", "key": "1051_recipient"}, {"id": "Field_A4_1051_information_provider", "type": "textfield", "key": "1051_information_provider"}]}, {"id": "Group_A5", "type": "group", "path": "A5", "components": [{"id": "Field_A5_resource", "type": "textfield", "key": "resource"}, {"id": "Field_A5_1058_observation_concept", "type": "textfield", "key": "1058_observation_concept"}]}, {"id": "Field_TC_A1_cycle", "type": "textfield", "key": "TC_A1_cycle"}, {"id": "Field_TC_A1_keep_alive_bound", "type": "textfield", "key": "TC_A1_keep_alive_bound"}, {"id": "Field_specimen_result", "type": "textfield", "key": "specimen_result"}]}</zeebe:userTaskForm>
      <zeebe:versionTag value="1.0.0_PT1" />
    </bpmn:extensionElements>
    <bpmn:subProcess id="start_node_cycle_scope" name="Scheduled execution" triggeredByEvent="true">
      <bpmn:startEvent id="start_node" name="Every 2 weeks" isInterrupting="false">
        <bpmn:outgoing>start_node_to_A1</bpmn:outgoing>
        <bpmn:timerEventDefinition id="start_node_definition">
          <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">= TC_A1_cycle</bpmn:timeCycle>
        </bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:serviceTask id="A1" name="Following blood sample collection">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="ad_collect_specimen" />
        </bpmn:extensionElements>
        <bpmn:incoming>start_node_to_A1</bpmn:incoming>
        <bpmn:outgoing>A1_to_div_gat_1</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="A2" name="if laboratory results are normal, chemotherapy is administered">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="ad_clinical_procedure" />
        </bpmn:extensionElements>
        <bpmn:incoming>div_gat_3_to_A2</bpmn:incoming>
        <bpmn:outgoing>A2_to_conv_gat_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="A3" name="vital signs are monitored">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="ad_request_observation" />
        </bpmn:extensionElements>
        <bpmn:incoming>div_gat_3_to_A3</bpmn:incoming>
        <bpmn:outgoing>A3_to_conv_gat_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="A4" name="Otherwise, the practitioner is alerted">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="ad_alert_practitioner" />
        </bpmn:extensionElements>
        <bpmn:incoming>div_gat_1_to_A4</bpmn:incoming>
        <bpmn:outgoing>A4_to_A5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="A5" name="an ECG is performed">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="ad_request_observation" />
        </bpmn:extensionElements>
        <bpmn:incoming>A4_to_A5</bpmn:incoming>
        <bpmn:outgoing>A5_to_conv_gat_2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="A4_to_A5" sourceRef="A4" targetRef="A5" />
      <bpmn:sequenceFlow id="start_node_to_A1" sourceRef="start_node" targetRef="A1" />
      <bpmn:sequenceFlow id="A1_to_div_gat_1" sourceRef="A1" targetRef="div_gat_1" />
      <bpmn:sequenceFlow id="div_gat_3_to_A2" sourceRef="div_gat_3" targetRef="A2" />
      <bpmn:sequenceFlow id="div_gat_3_to_A3" sourceRef="div_gat_3" targetRef="A3" />
      <bpmn:sequenceFlow id="div_gat_1_to_A4" name="Otherwise" sourceRef="div_gat_1" targetRef="A4" />
      <bpmn:sequenceFlow id="conv_gat_4_to_conv_gat_2" sourceRef="conv_gat_4" targetRef="conv_gat_2" />
      <bpmn:sequenceFlow id="A3_to_conv_gat_4" sourceRef="A3" targetRef="conv_gat_4" />
      <bpmn:sequenceFlow id="A5_to_conv_gat_2" sourceRef="A5" targetRef="conv_gat_2" />
      <bpmn:sequenceFlow id="conv_gat_2_to_end_node" sourceRef="conv_gat_2" targetRef="end_node" />
      <bpmn:exclusiveGateway id="div_gat_1" gatewayDirection="Diverging" default="div_gat_1_to_A4">
        <bpmn:incoming>A1_to_div_gat_1</bpmn:incoming>
        <bpmn:outgoing>div_gat_1_to_A4</bpmn:outgoing>
        <bpmn:outgoing>div_gat_1_to_div_gat_3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="conv_gat_2" gatewayDirection="Converging">
        <bpmn:incoming>conv_gat_4_to_conv_gat_2</bpmn:incoming>
        <bpmn:incoming>A5_to_conv_gat_2</bpmn:incoming>
        <bpmn:outgoing>conv_gat_2_to_end_node</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="end_node">
        <bpmn:incoming>conv_gat_2_to_end_node</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="div_gat_1_to_div_gat_3" name="if laboratory results are normal" sourceRef="div_gat_1" targetRef="div_gat_3">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= specimen_result = "normal"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:parallelGateway id="div_gat_3">
        <bpmn:incoming>div_gat_1_to_div_gat_3</bpmn:incoming>
        <bpmn:outgoing>div_gat_3_to_A3</bpmn:outgoing>
        <bpmn:outgoing>div_gat_3_to_A2</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:sequenceFlow id="A2_to_conv_gat_4" sourceRef="A2" targetRef="conv_gat_4" />
      <bpmn:parallelGateway id="conv_gat_4">
        <bpmn:incoming>A2_to_conv_gat_4</bpmn:incoming>
        <bpmn:incoming>A3_to_conv_gat_4</bpmn:incoming>
        <bpmn:outgoing>conv_gat_4_to_conv_gat_2</bpmn:outgoing>
      </bpmn:parallelGateway>
    </bpmn:subProcess>
    <bpmn:startEvent id="ka_start_event_1">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:Form_7_1.0.0_PT1" />
      </bpmn:extensionElements>
      <bpmn:outgoing>ka_start_event_1_to_ka_timer_event_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="ka_start_event_1_to_ka_timer_event_1" sourceRef="ka_start_event_1" targetRef="ka_timer_event_1" />
    <bpmn:sequenceFlow id="ka_timer_event_1_to_ka_end_event_1" sourceRef="ka_timer_event_1" targetRef="ka_end_event_1" />
    <bpmn:intermediateCatchEvent id="ka_timer_event_1" name="">
      <bpmn:incoming>ka_start_event_1_to_ka_timer_event_1</bpmn:incoming>
      <bpmn:outgoing>ka_timer_event_1_to_ka_end_event_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ka_timer_event_1_definition">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= TC_A1_keep_alive_bound</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ka_end_event_1">
      <bpmn:incoming>ka_timer_event_1_to_ka_end_event_1</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P07_diagram">
    <bpmndi:BPMNPlane id="P07_plane" bpmnElement="P07">
      <bpmndi:BPMNShape id="ka_start_event_1_shape" bpmnElement="ka_start_event_1">
        <dc:Bounds x="160" y="614" width="36" height="36" />
