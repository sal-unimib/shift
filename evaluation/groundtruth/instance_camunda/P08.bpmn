        <bpmn:sequenceFlow id="A3_to_block_end_event_2" sourceRef="A3" targetRef="block_end_event_2" />
        <bpmn:endEvent id="block_end_event_2">
          <bpmn:incoming>A3_to_block_end_event_2</bpmn:incoming>
        </bpmn:endEvent>
      </bpmn:subProcess>
      <bpmn:startEvent id="ka_start_event_2">
